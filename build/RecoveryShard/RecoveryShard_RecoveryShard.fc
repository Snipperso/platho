;;
;; Routing of a Contract RecoveryShard
;;

;; message opcode reader utility: only binary receivers
;; Returns 32 bit message opcode, otherwise throws the "Invalid incoming message" exit code
(slice, int) ~load_opcode_internal(slice s) asm( -> 1 0) "32 LDUQ 130 THROWIFNOT";

() recv_internal(int msg_value, cell in_msg_cell, slice in_msg) impure {
    
    ;; Context
    var cs = in_msg_cell.begin_parse();
    cs~skip_bits(2);
    var msg_bounceable = cs~load_int(1);
    var msg_bounced = cs~load_int(1);
    slice msg_sender_addr = cs~load_msg_addr();
    __tact_context = (msg_bounceable, msg_sender_addr, msg_value, cs);
    __tact_context_sender = msg_sender_addr;
    
    ;; Load contract data
    var ($self'self_bucket_key, $self'bound, $self'owner_pubkey, $self'seq, $self'h0, $self'h1, $self'bh, $self'body, $self'updated_at) = $RecoveryShard$_contract_load();
    
    ;; Handle bounced messages
    if (msg_bounced) { return (); }
    int op = 0;
    int in_msg_length = slice_bits(in_msg);
    if (in_msg_length >= 32) {
        op = in_msg~load_uint(32);
    }
    ;; Receive RecoveryStore message
    if (op == 0x52435631) {
        var $msg'owner_pubkey = in_msg~load_uint(256);
        var $msg'seq = in_msg~load_uint(64);
        var $msg'h0 = in_msg~load_uint(256);
        var $msg'h1 = in_msg~load_uint(256);
        slice sc_1 = in_msg~load_ref().begin_parse();
        var $msg'bh = sc_1~load_uint(256);
        var $msg'body = sc_1~load_ref();
        var $msg'owner_sig = sc_1~load_ref();
        throw_unless(13571, ( (( (($msg'h0 != 0)) ? (($msg'h1 != 0)) : (false) )) ? (($msg'bh != 0)) : (false) ));
        throw_unless(13557, ($Cell$_fun_hash($msg'body) == $msg'bh));
        throw_unless(13572, ($Context$_get_value(__tact_context_get()) >= 31200000));
        var ($blob'cells, $blob'bits, $blob'refs) = $Cell$_fun_computeDataSize($msg'body, 1024);
        throw_unless(13560, ($blob'cells <= 79));
        int $wasUnbound = (~ $self'bound);
        ifnot ($self'bound) {
            throw_unless(13573, ($msg'seq > $self'seq));
            throw_unless(13575, ($self'self_bucket_key == ($self'self_bucket_key, $self'bound, $self'owner_pubkey, $self'seq, $self'h0, $self'h1, $self'bh, $self'body, $self'updated_at)~$RecoveryShard$_fun_slotKeyForOwner($msg'owner_pubkey)));
            $self'bound = true;
            $self'owner_pubkey = $msg'owner_pubkey;
        } else {
            throw_unless(13563, ($msg'owner_pubkey == $self'owner_pubkey));
            throw_unless(13564, ($msg'seq > $self'seq));
        }
        throw_unless(13574, $global_checkSignature(($self'self_bucket_key, $self'bound, $self'owner_pubkey, $self'seq, $self'h0, $self'h1, $self'bh, $self'body, $self'updated_at)~$RecoveryShard$_fun_recoveryDigest($msg'seq, $msg'h0, $msg'h1, $msg'bh), $Cell$_fun_beginParse($msg'owner_sig), $self'owner_pubkey));
        $self'seq = $msg'seq;
        $self'h0 = $msg'h0;
        $self'h1 = $msg'h1;
        $self'bh = $msg'bh;
        $self'body = $msg'body;
        $self'updated_at = $global_now();
        $global_nativeReserve(($wasUnbound ? 23200000 : 0), 6);
        $global_send($SendParameters$_constructor_to_value_mode_bounce(__tact_context_get_sender(), 0, 130, false));
        $RecoveryShard$_contract_store(($self'self_bucket_key, $self'bound, $self'owner_pubkey, $self'seq, $self'h0, $self'h1, $self'bh, $self'body, $self'updated_at));
        return ();
    }
    
    ;; Receive EvictRecovery message
    if (op == 0x52435632) {
        var $_ = empty_tuple();
        throw_unless(13561, $self'bound);
        throw_unless(13562, (($self'updated_at + 94608000) < $global_now()));
        $self'bound = false;
        $self'owner_pubkey = 0;
        $self'h0 = 0;
        $self'h1 = 0;
        $self'bh = 0;
        $self'body = $global_emptyCell();
        $self'updated_at = 0;
        $global_send($SendParameters$_constructor_to_value_mode_bounce(__tact_context_get_sender(), 0, 130, false));
        $RecoveryShard$_contract_store(($self'self_bucket_key, $self'bound, $self'owner_pubkey, $self'seq, $self'h0, $self'h1, $self'bh, $self'body, $self'updated_at));
        return ();
    }
    
    ;; Receive empty message
    if ((op == 0) & (in_msg_length <= 32)) {
        $RecoveryShard$_contract_store(($self'self_bucket_key, $self'bound, $self'owner_pubkey, $self'seq, $self'h0, $self'h1, $self'bh, $self'body, $self'updated_at));
        return ();
    }
    ;; Throw if not handled
    throw(130);
}
