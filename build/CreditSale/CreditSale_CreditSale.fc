;; Returns 32 bit message opcode, or returns immediately if the message is shorter than 32 bits
(slice, int) ~load_opcode_internal(slice s) asm( -> 1 0) "32 LDUQ IFNOTRET";

() recv_internal(int msg_value, cell in_msg_cell, slice in_msg) impure {
    
    ;; Context
    var cs = in_msg_cell.begin_parse();
    cs~skip_bits(2);
    var msg_bounceable = cs~load_int(1);
    var msg_bounced = cs~load_int(1);
    slice msg_sender_addr = cs~load_msg_addr();
    __tact_context = (msg_bounceable, msg_sender_addr, msg_value, cs);
    __tact_context_sender = msg_sender_addr;
    
    ;; Load contract data
    var ($self'sealed, $self'genesis_controller_address, $self'deployment_manifest_hash, $self'airdrop_pool_address, $self'airdrop_pool_bound, $self'fee_receiver_address, $self'fee_receiver_bound, $self'credit_fee, $self'fees_collected, $self'credits_sold, $self'purchase_seq) = $CreditSale$_contract_load();
    
    ;; Handle bounced messages
    if (msg_bounced) { return (); }
    int op = 0;
    int in_msg_length = slice_bits(in_msg);
    if (in_msg_length >= 32) {
        op = in_msg.preload_uint(32);
    }
    ;; Receive CsBindAirdropPool message
    if (op == 0x43533031) {
        in_msg~skip_bits(32);
        var $msg'airdrop_pool_address = in_msg~load_msg_addr();
        ($self'sealed, $self'genesis_controller_address, $self'deployment_manifest_hash, $self'airdrop_pool_address, $self'airdrop_pool_bound, $self'fee_receiver_address, $self'fee_receiver_bound, $self'credit_fee, $self'fees_collected, $self'credits_sold, $self'purchase_seq)~$CreditSale$_fun_requireUnsealed();
        ($self'sealed, $self'genesis_controller_address, $self'deployment_manifest_hash, $self'airdrop_pool_address, $self'airdrop_pool_bound, $self'fee_receiver_address, $self'fee_receiver_bound, $self'credit_fee, $self'fees_collected, $self'credits_sold, $self'purchase_seq)~$CreditSale$_fun_requireController();
        throw_unless(27010, (~ $self'airdrop_pool_bound));
        $self'airdrop_pool_address = $msg'airdrop_pool_address;
        $self'airdrop_pool_bound = true;
        $CreditSale$_contract_store(($self'sealed, $self'genesis_controller_address, $self'deployment_manifest_hash, $self'airdrop_pool_address, $self'airdrop_pool_bound, $self'fee_receiver_address, $self'fee_receiver_bound, $self'credit_fee, $self'fees_collected, $self'credits_sold, $self'purchase_seq));
        return ();
    }
    
    ;; Receive CsBindFeeReceiver message
    if (op == 0x43533032) {
        in_msg~skip_bits(32);
        var $msg'fee_receiver_address = in_msg~load_msg_addr();
        ($self'sealed, $self'genesis_controller_address, $self'deployment_manifest_hash, $self'airdrop_pool_address, $self'airdrop_pool_bound, $self'fee_receiver_address, $self'fee_receiver_bound, $self'credit_fee, $self'fees_collected, $self'credits_sold, $self'purchase_seq)~$CreditSale$_fun_requireUnsealed();
        ($self'sealed, $self'genesis_controller_address, $self'deployment_manifest_hash, $self'airdrop_pool_address, $self'airdrop_pool_bound, $self'fee_receiver_address, $self'fee_receiver_bound, $self'credit_fee, $self'fees_collected, $self'credits_sold, $self'purchase_seq)~$CreditSale$_fun_requireController();
        throw_unless(27012, (~ $self'fee_receiver_bound));
        $self'fee_receiver_address = $msg'fee_receiver_address;
        $self'fee_receiver_bound = true;
        $CreditSale$_contract_store(($self'sealed, $self'genesis_controller_address, $self'deployment_manifest_hash, $self'airdrop_pool_address, $self'airdrop_pool_bound, $self'fee_receiver_address, $self'fee_receiver_bound, $self'credit_fee, $self'fees_collected, $self'credits_sold, $self'purchase_seq));
