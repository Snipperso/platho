    }
    
    ;; Receive CsSetCreditFee message
    if (op == 0x43533033) {
        in_msg~skip_bits(32);
        var $msg'credit_fee = in_msg~load_uint(128);
        ($self'sealed, $self'genesis_controller_address, $self'deployment_manifest_hash, $self'airdrop_pool_address, $self'airdrop_pool_bound, $self'fee_receiver_address, $self'fee_receiver_bound, $self'credit_fee, $self'fees_collected, $self'credits_sold, $self'purchase_seq)~$CreditSale$_fun_requireUnsealed();
        ($self'sealed, $self'genesis_controller_address, $self'deployment_manifest_hash, $self'airdrop_pool_address, $self'airdrop_pool_bound, $self'fee_receiver_address, $self'fee_receiver_bound, $self'credit_fee, $self'fees_collected, $self'credits_sold, $self'purchase_seq)~$CreditSale$_fun_requireController();
        throw_unless(27014, ($msg'credit_fee > 0));
        $self'credit_fee = $msg'credit_fee;
        $CreditSale$_contract_store(($self'sealed, $self'genesis_controller_address, $self'deployment_manifest_hash, $self'airdrop_pool_address, $self'airdrop_pool_bound, $self'fee_receiver_address, $self'fee_receiver_bound, $self'credit_fee, $self'fees_collected, $self'credits_sold, $self'purchase_seq));
        return ();
    }
    
    ;; Receive CsSealGenesis message
    if (op == 0x43533034) {
        in_msg~skip_bits(32);
        var $msg'deployment_manifest_hash = in_msg~load_uint(256);
        ($self'sealed, $self'genesis_controller_address, $self'deployment_manifest_hash, $self'airdrop_pool_address, $self'airdrop_pool_bound, $self'fee_receiver_address, $self'fee_receiver_bound, $self'credit_fee, $self'fees_collected, $self'credits_sold, $self'purchase_seq)~$CreditSale$_fun_requireUnsealed();
        ($self'sealed, $self'genesis_controller_address, $self'deployment_manifest_hash, $self'airdrop_pool_address, $self'airdrop_pool_bound, $self'fee_receiver_address, $self'fee_receiver_bound, $self'credit_fee, $self'fees_collected, $self'credits_sold, $self'purchase_seq)~$CreditSale$_fun_requireController();
        throw_unless(27040, ($msg'deployment_manifest_hash == $self'deployment_manifest_hash));
        throw_unless(27041, $self'airdrop_pool_bound);
        throw_unless(27042, $self'fee_receiver_bound);
        throw_unless(27043, ($self'credit_fee > 0));
        $self'sealed = true;
        $CreditSale$_contract_store(($self'sealed, $self'genesis_controller_address, $self'deployment_manifest_hash, $self'airdrop_pool_address, $self'airdrop_pool_bound, $self'fee_receiver_address, $self'fee_receiver_bound, $self'credit_fee, $self'fees_collected, $self'credits_sold, $self'purchase_seq));
        return ();
    }
    
    ;; Receive CsBuyCredits message
    if (op == 0x43533035) {
        in_msg~skip_bits(32);
        var $msg'credits_k = in_msg~load_uint(16);
        var $msg'redeem_pubkey = in_msg~load_uint(256);
        ($self'sealed, $self'genesis_controller_address, $self'deployment_manifest_hash, $self'airdrop_pool_address, $self'airdrop_pool_bound, $self'fee_receiver_address, $self'fee_receiver_bound, $self'credit_fee, $self'fees_collected, $self'credits_sold, $self'purchase_seq)~$CreditSale$_fun_requireSealed();
        throw_unless(27101, ( (($msg'credits_k >= 1)) ? (($msg'credits_k <= 1000)) : (false) ));
        int $fee = ($msg'credits_k * $self'credit_fee);
