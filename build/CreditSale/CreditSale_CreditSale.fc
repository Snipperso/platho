        int $due = $self'fees_collected;
        throw_unless(27110, ($due > 0));
        throw_unless(27111, ($global_myBalance() >= ((100000000 + $due) + 2000000)));
        $self'fees_collected = 0;
        $global_send($SendParameters$_constructor_to_value_mode_bounce_body($self'fee_receiver_address, ($due + 2000000), 1, false, $DepositProtocolFee$_store_cell($DepositProtocolFee$_constructor_amount($due), begin_cell())));
        $CreditSale$_contract_store(($self'sealed, $self'genesis_controller_address, $self'deployment_manifest_hash, $self'airdrop_pool_address, $self'airdrop_pool_bound, $self'fee_receiver_address, $self'fee_receiver_bound, $self'credit_fee, $self'fees_collected, $self'credits_sold, $self'purchase_seq));
        return ();
    }
    
    ;; Receive CsTopUpStorageReserve message
    if (op == 0x43533037) {
        in_msg~skip_bits(32);
        var $_ = empty_tuple();
        $CreditSale$_contract_store(($self'sealed, $self'genesis_controller_address, $self'deployment_manifest_hash, $self'airdrop_pool_address, $self'airdrop_pool_bound, $self'fee_receiver_address, $self'fee_receiver_bound, $self'credit_fee, $self'fees_collected, $self'credits_sold, $self'purchase_seq));
