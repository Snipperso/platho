    }
    
    ;; Receive empty message
    if ((op == 0) & (in_msg_length <= 32)) {
        $CreditSale$_contract_store(($self'sealed, $self'genesis_controller_address, $self'deployment_manifest_hash, $self'airdrop_pool_address, $self'airdrop_pool_bound, $self'fee_receiver_address, $self'fee_receiver_bound, $self'credit_fee, $self'fees_collected, $self'credits_sold, $self'purchase_seq));
        return ();
    }
    ;; Receiver fallback
    $CreditSale$_contract_store(($self'sealed, $self'genesis_controller_address, $self'deployment_manifest_hash, $self'airdrop_pool_address, $self'airdrop_pool_bound, $self'fee_receiver_address, $self'fee_receiver_bound, $self'credit_fee, $self'fees_collected, $self'credits_sold, $self'purchase_seq));
}
