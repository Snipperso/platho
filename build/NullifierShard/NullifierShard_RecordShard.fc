builder $RecordShard$_store(builder build_0, (int, int, cell, int) v) inline {
    var (v'bucket_key, v'epoch, v'records, v'record_count) = v;
    build_0 = build_0.store_uint(v'bucket_key, 256);
    build_0 = build_0.store_uint(v'epoch, 32);
    build_0 = build_0.store_dict(v'records);
    build_0 = build_0.store_uint(v'record_count, 32);
    return build_0;
}

(slice, ((int, int, cell, int))) $RecordShard$_load(slice sc_0) inline {
    var v'bucket_key = sc_0~load_uint(256);
    var v'epoch = sc_0~load_uint(32);
    var v'records = sc_0~load_dict();
    var v'record_count = sc_0~load_uint(32);
    return (sc_0, (v'bucket_key, v'epoch, v'records, v'record_count));
}

(slice, ((int, int))) $RecordShard$init$_load(slice sc_0) inline {
    var v'bucket_key = sc_0~load_int(257);
    var v'epoch = sc_0~load_int(257);
    return (sc_0, (v'bucket_key, v'epoch));
}

(int, int, cell, int) $RecordShard$_contract_load() impure inline {
    slice $sc = get_data().begin_parse();
    __tact_child_contract_codes = $sc~load_ref();
    int $loaded = $sc~load_int(1);
    if ($loaded) {
        return $sc~$RecordShard$_load();
    }
    else {
        (int $bucket_key, int $epoch) = $sc~$RecordShard$init$_load();
        $sc.end_parse();
        return $RecordShard$_contract_init($bucket_key, $epoch);
    }
}

() $RecordShard$_contract_store((int, int, cell, int) v) impure inline {
    builder b = begin_cell();
    b = b.store_ref(__tact_child_contract_codes);
    b = b.store_int(true, 1);
    b = $RecordShard$_store(b, v);
    set_data(b.end_cell());
}

;;
;; Type: NullifierShard
;; TLB: _ epoch:uint32 lane:uint32 spent:dict<int, bool> spent_count:uint32 = NullifierShard
;;

builder $NullifierShard$init$_store(builder build_0, (int, int) v) inline {
    var (v'epoch, v'lane) = v;
    build_0 = build_0.store_int(v'epoch, 257);
    build_0 = build_0.store_int(v'lane, 257);
    return build_0;
}

(cell, cell) $NullifierShard$_init_child(int $epoch, int $lane) inline_ref {
    ;; Build init code cell

    slice sc' = __tact_child_contract_codes.begin_parse();
    cell source = sc'~load_dict();
    ;; Contract Code: NullifierShard
    cell init_code = __tact_dict_get_code(source, 34652);

    ;; Build init data cell
    cell contracts = new_dict();

    ;; Contract Code: RecordShard
    contracts = __tact_dict_set_code(contracts, 52655, my_code());

    builder b = begin_cell();
    b = b.store_builder_ref(begin_cell().store_dict(contracts));
    b = b.store_int(false, 1);
    b = $NullifierShard$init$_store(b, ($epoch, $lane));
    return (init_code, b.end_cell());
}

