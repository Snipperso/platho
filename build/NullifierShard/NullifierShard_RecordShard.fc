(int, int, cell, int) $RecordShard$_contract_init(int $bucket_key, int $epoch) impure inline {
    var (($self'bucket_key, $self'epoch, $self'records, $self'record_count)) = (null(), null(), null(), null());
    $self'bucket_key = $bucket_key;
    $self'epoch = $epoch;
    $self'records = null();
    $self'record_count = 0;
    return ($self'bucket_key, $self'epoch, $self'records, $self'record_count);
}

((int, int, cell, int), (int, int)) $RecordShard$_fun_get_record((int, int, cell, int) $self, int $entry_id) impure inline_ref {
    var (($self'bucket_key, $self'epoch, $self'records, $self'record_count)) = $self;
    int $fc = __tact_dict_get_int_int($self'records, 257, $entry_id, 257);
    if (null?($fc)) {
        var $fresh$ret_0 = $CapsuleRecordView$_constructor_exists_frame_commit(false, 0);
        return (($self'bucket_key, $self'epoch, $self'records, $self'record_count), $fresh$ret_0);
    }
    var $fresh$ret_1 = $CapsuleRecordView$_constructor_exists_frame_commit(true, $fc);
    return (($self'bucket_key, $self'epoch, $self'records, $self'record_count), $fresh$ret_1);
}

((int, int, cell, int), (int, int, int, int, int)) $RecordShard$_fun_get_view((int, int, cell, int) $self) impure inline_ref {
    var (($self'bucket_key, $self'epoch, $self'records, $self'record_count)) = $self;
    var $fresh$ret_2 = $RecordShardView$_constructor_bucket_key_epoch_record_count_lane_count_safe_cap($self'bucket_key, $self'epoch, $self'record_count, 1048576, 4096);
    return (($self'bucket_key, $self'epoch, $self'records, $self'record_count), $fresh$ret_2);
}

