        var $msg'intro_bucket = sc_1~load_uint(32);
        var $msg'intro_r = sc_1~load_uint(256);
        var $msg'intro_view_tag = sc_1~load_uint(16);
        var $msg'issuer_sig = sc_1~load_ref();
        var $msg'cert_sig_a = sc_1~load_ref();
        var $msg'cert_sig_b = sc_1~load_ref();
        var $msg'spend_sig = sc_1~load_ref();
        int $nowEpoch = ($global_now() / 86400);
        throw_unless(13600, ( (($msg'epoch >= ($nowEpoch - 4))) ? (($msg'epoch <= ($nowEpoch + 4))) : (false) ));
        throw_unless(13625, ( (($msg'kind == 1)) ? (true) : (($msg'kind == 2)) ));
        throw_unless(13621, ($msg'epoch == $self'epoch));
        int $serial = ($self'epoch, $self'lane, $self'spent, $self'spent_count)~$NullifierShard$_fun_computeSerial($msg'spend_pubkey, $msg'epoch, $msg'nonce);
        throw_unless(13622, (($serial % 1048576) == $self'lane));
        throw_unless(13630, ( (($msg'epoch >= $msg'valid_from)) ? (($msg'epoch <= $msg'valid_to)) : (false) ));
        throw_unless(13636, ($msg'valid_to <= ($msg'valid_from + 550)));
        throw_unless(13631, ($msg'root_idx_a < $msg'root_idx_b));
        int $ka = ($self'epoch, $self'lane, $self'spent, $self'spent_count)~$NullifierShard$_fun_rootKey($msg'root_idx_a);
        int $kb = ($self'epoch, $self'lane, $self'spent, $self'spent_count)~$NullifierShard$_fun_rootKey($msg'root_idx_b);
        throw_unless(13632, ($ka != $kb));
