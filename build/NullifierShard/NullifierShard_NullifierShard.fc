        ;; Skip 0xFFFFFFFF prefix of a bounced message
        in_msg~skip_bits(32);
        int op = 0;
        if (slice_bits(in_msg) >= 32) {
            op = in_msg~load_uint(32);
        }
        ;; Bounced handler for RecordStore message
        if (op == 0x52535031) {
            var $_ = in_msg~$RecordStore$_load_bounced();
            $NullifierShard$_contract_store(($self'epoch, $self'lane, $self'spent, $self'spent_count));
            return ();
        }
        
        ;; Bounced handler for IntroStore message
