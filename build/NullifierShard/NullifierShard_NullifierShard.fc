;; message opcode reader utility: only binary receivers
;; Returns 32 bit message opcode, otherwise throws the "Invalid incoming message" exit code
(slice, int) ~load_opcode_internal(slice s) asm( -> 1 0) "32 LDUQ 130 THROWIFNOT";

() recv_internal(int msg_value, cell in_msg_cell, slice in_msg) impure {
    
    ;; Context
    var cs = in_msg_cell.begin_parse();
    cs~skip_bits(2);
    var msg_bounceable = cs~load_int(1);
    var msg_bounced = cs~load_int(1);
    slice msg_sender_addr = cs~load_msg_addr();
    __tact_context = (msg_bounceable, msg_sender_addr, msg_value, cs);
    __tact_context_sender = msg_sender_addr;
    
    ;; Load contract data
    var ($self'epoch, $self'lane, $self'spent, $self'spent_count) = $NullifierShard$_contract_load();
    
    ;; Handle bounced messages
    if (msg_bounced) { return (); }
    int op = 0;
    int in_msg_length = slice_bits(in_msg);
    if (in_msg_length >= 32) {
        op = in_msg~load_uint(32);
    }
    ;; Receive NullifierSpend message
    if (op == 0x4e535032) {
        var $msg'spend_pubkey = in_msg~load_uint(256);
        var $msg'epoch = in_msg~load_uint(32);
        var $msg'nonce = in_msg~load_uint(64);
        var $msg'subkey_pubkey = in_msg~load_uint(256);
        var $msg'valid_from = in_msg~load_uint(32);
        var $msg'valid_to = in_msg~load_uint(32);
        var $msg'root_idx_a = in_msg~load_uint(8);
        var $msg'root_idx_b = in_msg~load_uint(8);
        var $msg'issuer_sig = in_msg~load_ref();
        var $msg'cert_sig_a = in_msg~load_ref();
        var $msg'cert_sig_b = in_msg~load_ref();
        int $nowEpoch = ($global_now() / 86400);
        throw_unless(13600, ( (($msg'epoch >= ($nowEpoch - 4))) ? (($msg'epoch <= ($nowEpoch + 4))) : (false) ));
        throw_unless(13621, ($msg'epoch == $self'epoch));
        int $serial = ($self'epoch, $self'lane, $self'spent, $self'spent_count)~$NullifierShard$_fun_computeSerial($msg'spend_pubkey, $msg'epoch, $msg'nonce);
        throw_unless(13622, (($serial % 1048576) == $self'lane));
        throw_unless(13630, ( (($msg'epoch >= $msg'valid_from)) ? (($msg'epoch <= $msg'valid_to)) : (false) ));
        throw_unless(13636, ($msg'valid_to <= ($msg'valid_from + 550)));
        throw_unless(13631, ($msg'root_idx_a < $msg'root_idx_b));
        int $ka = ($self'epoch, $self'lane, $self'spent, $self'spent_count)~$NullifierShard$_fun_rootKey($msg'root_idx_a);
        int $kb = ($self'epoch, $self'lane, $self'spent, $self'spent_count)~$NullifierShard$_fun_rootKey($msg'root_idx_b);
        throw_unless(13632, ($ka != $kb));
        int $cd = ($self'epoch, $self'lane, $self'spent, $self'spent_count)~$NullifierShard$_fun_certDigest($msg'subkey_pubkey, $msg'valid_from, $msg'valid_to);
        throw_unless(13633, $global_checkSignature($cd, $Cell$_fun_beginParse($msg'cert_sig_a), $ka));
        throw_unless(13634, $global_checkSignature($cd, $Cell$_fun_beginParse($msg'cert_sig_b), $kb));
        throw_unless(13601, $global_checkSignature($serial, $Cell$_fun_beginParse($msg'issuer_sig), $msg'subkey_pubkey));
        int $nk = ($self'epoch, $self'lane, $self'spent, $self'spent_count)~$NullifierShard$_fun_nullifierKey($serial);
        throw_unless(13604, null?(__tact_dict_get_int_int($self'spent, 257, $nk, 1)));
        throw_unless(13623, ($self'spent_count < 4096));
        $self'spent~__tact_dict_set_int_int(257, $nk, true, 1);
        $self'spent_count = ($self'spent_count + 1);
        $NullifierShard$_contract_store(($self'epoch, $self'lane, $self'spent, $self'spent_count));
        return ();
    }
    
    ;; Receive empty message
    if ((op == 0) & (in_msg_length <= 32)) {
        $NullifierShard$_contract_store(($self'epoch, $self'lane, $self'spent, $self'spent_count));
        return ();
    }
    ;; Throw if not handled
    throw(130);
}
