        var $msg'spend_pubkey = in_msg~load_uint(256);
        var $msg'epoch = in_msg~load_uint(32);
        var $msg'nonce = in_msg~load_uint(64);
        var $msg'subkey_pubkey = in_msg~load_uint(256);
        var $msg'valid_from = in_msg~load_uint(32);
        var $msg'valid_to = in_msg~load_uint(32);
        var $msg'root_idx_a = in_msg~load_uint(8);
        var $msg'root_idx_b = in_msg~load_uint(8);
        var $msg'kind = in_msg~load_uint(8);
