            var $_ = in_msg~$IntroStore$_load_bounced();
            $NullifierShard$_contract_store(($self'epoch, $self'lane, $self'spent, $self'spent_count));
            return ();
        }
        
        return ();
    }
    int op = 0;
    int in_msg_length = slice_bits(in_msg);
    if (in_msg_length >= 32) {
        op = in_msg~load_uint(32);
    }
