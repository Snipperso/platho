        throw_unless(13633, $global_checkSignature($cd, $Cell$_fun_beginParse($msg'cert_sig_a), $ka));
        throw_unless(13634, $global_checkSignature($cd, $Cell$_fun_beginParse($msg'cert_sig_b), $kb));
