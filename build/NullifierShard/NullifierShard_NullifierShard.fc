        throw_unless(13604, null?(__tact_dict_get_int_int($self'spent, 257, $nk, 1)));
        throw_unless(13623, ($self'spent_count < 4096));
        throw_unless(13624, ($Context$_get_value(__tact_context_get()) >= 7710000));
        $self'spent~__tact_dict_set_int_int(257, $nk, true, 1);
        $self'spent_count = ($self'spent_count + 1);
        $global_nativeReserve((1000000 + ($self'spent_count * 10000)), 2);
