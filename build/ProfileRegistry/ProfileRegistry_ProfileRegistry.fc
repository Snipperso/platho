        ($self'official_ath_wallet_address, $self'ath_master_address, $self'treasury_ath_receiver_address, $self'official_ath_wallet_bound, $self'sealed, $self'deployment_manifest_hash, $self'genesis_config_hash, $self'genesis_controller_address, $self'profile_count, $self'avatar_record_count, $self'treasury_due_ath, $self'burn_due_ath, $self'current_avatar_versions, $self'avatar_records, $self'pending_treasury_flushes, $self'pending_treasury_flush_count, $self'pending_burn_flushes, $self'pending_burn_flush_count)~$ProfileRegistry$_fun_requireSealed();
        throw_unless(21330, ( equal_slices_bits(__tact_context_get_sender(), $self'ath_master_address) ));
        var ($pending'amount, $pending'created_at) = ($self'official_ath_wallet_address, $self'ath_master_address, $self'treasury_ath_receiver_address, $self'official_ath_wallet_bound, $self'sealed, $self'deployment_manifest_hash, $self'genesis_config_hash, $self'genesis_controller_address, $self'profile_count, $self'avatar_record_count, $self'treasury_due_ath, $self'burn_due_ath, $self'current_avatar_versions, $self'avatar_records, $self'pending_treasury_flushes, $self'pending_treasury_flush_count, $self'pending_burn_flushes, $self'pending_burn_flush_count)~$ProfileRegistry$_fun_clearPendingBurnFlush($msg'query_id);
        throw_unless(21331, ($pending'amount == $msg'amount));
        $ProfileRegistry$_contract_store(($self'official_ath_wallet_address, $self'ath_master_address, $self'treasury_ath_receiver_address, $self'official_ath_wallet_bound, $self'sealed, $self'deployment_manifest_hash, $self'genesis_config_hash, $self'genesis_controller_address, $self'profile_count, $self'avatar_record_count, $self'treasury_due_ath, $self'burn_due_ath, $self'current_avatar_versions, $self'avatar_records, $self'pending_treasury_flushes, $self'pending_treasury_flush_count, $self'pending_burn_flushes, $self'pending_burn_flush_count));
        return ();
    }
    
    ;; Receive ATHBurnFailed message
    if (op == 0x41544804) {
        var $msg'query_id = in_msg~load_uint(64);
        var $msg'amount = in_msg~load_uint(128);
        ($self'official_ath_wallet_address, $self'ath_master_address, $self'treasury_ath_receiver_address, $self'official_ath_wallet_bound, $self'sealed, $self'deployment_manifest_hash, $self'genesis_config_hash, $self'genesis_controller_address, $self'profile_count, $self'avatar_record_count, $self'treasury_due_ath, $self'burn_due_ath, $self'current_avatar_versions, $self'avatar_records, $self'pending_treasury_flushes, $self'pending_treasury_flush_count, $self'pending_burn_flushes, $self'pending_burn_flush_count)~$ProfileRegistry$_fun_requireSealed();
        throw_unless(21340, ( equal_slices_bits(__tact_context_get_sender(), $self'official_ath_wallet_address) ));
        var ($pending'amount, $pending'created_at) = ($self'official_ath_wallet_address, $self'ath_master_address, $self'treasury_ath_receiver_address, $self'official_ath_wallet_bound, $self'sealed, $self'deployment_manifest_hash, $self'genesis_config_hash, $self'genesis_controller_address, $self'profile_count, $self'avatar_record_count, $self'treasury_due_ath, $self'burn_due_ath, $self'current_avatar_versions, $self'avatar_records, $self'pending_treasury_flushes, $self'pending_treasury_flush_count, $self'pending_burn_flushes, $self'pending_burn_flush_count)~$ProfileRegistry$_fun_clearPendingBurnFlush($msg'query_id);
        throw_unless(21341, ($pending'amount == $msg'amount));
        ($self'official_ath_wallet_address, $self'ath_master_address, $self'treasury_ath_receiver_address, $self'official_ath_wallet_bound, $self'sealed, $self'deployment_manifest_hash, $self'genesis_config_hash, $self'genesis_controller_address, $self'profile_count, $self'avatar_record_count, $self'treasury_due_ath, $self'burn_due_ath, $self'current_avatar_versions, $self'avatar_records, $self'pending_treasury_flushes, $self'pending_treasury_flush_count, $self'pending_burn_flushes, $self'pending_burn_flush_count)~$ProfileRegistry$_fun_restoreBurnDue($pending'amount);
        $ProfileRegistry$_contract_store(($self'official_ath_wallet_address, $self'ath_master_address, $self'treasury_ath_receiver_address, $self'official_ath_wallet_bound, $self'sealed, $self'deployment_manifest_hash, $self'genesis_config_hash, $self'genesis_controller_address, $self'profile_count, $self'avatar_record_count, $self'treasury_due_ath, $self'burn_due_ath, $self'current_avatar_versions, $self'avatar_records, $self'pending_treasury_flushes, $self'pending_treasury_flush_count, $self'pending_burn_flushes, $self'pending_burn_flush_count));
        return ();
    }
    
    ;; Receive ProfileRegistryTopUpStorageReserve message
    if (op == 0x50a61120) {
        var $msg = empty_tuple();
        $ProfileRegistry$_contract_store(($self'official_ath_wallet_address, $self'ath_master_address, $self'treasury_ath_receiver_address, $self'official_ath_wallet_bound, $self'sealed, $self'deployment_manifest_hash, $self'genesis_config_hash, $self'genesis_controller_address, $self'profile_count, $self'avatar_record_count, $self'treasury_due_ath, $self'burn_due_ath, $self'current_avatar_versions, $self'avatar_records, $self'pending_treasury_flushes, $self'pending_treasury_flush_count, $self'pending_burn_flushes, $self'pending_burn_flush_count));
        return ();
    }
    
    ;; Receive empty message
    if ((op == 0) & (in_msg_length <= 32)) {
        throw(21400);
        $ProfileRegistry$_contract_store(($self'official_ath_wallet_address, $self'ath_master_address, $self'treasury_ath_receiver_address, $self'official_ath_wallet_bound, $self'sealed, $self'deployment_manifest_hash, $self'genesis_config_hash, $self'genesis_controller_address, $self'profile_count, $self'avatar_record_count, $self'treasury_due_ath, $self'burn_due_ath, $self'current_avatar_versions, $self'avatar_records, $self'pending_treasury_flushes, $self'pending_treasury_flush_count, $self'pending_burn_flushes, $self'pending_burn_flush_count));
        return ();
    }
    ;; Throw if not handled
    throw(130);
}
