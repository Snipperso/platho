            var ($msg'amount) = in_msg~$AcceptBurnReserve$_load_bounced();
            throw_unless(21130, ( equal_slices_bits(__tact_context_get_sender(), $self'buyback_burn_address) ));
            throw_unless(21131, ($msg'amount > 0));
            $self'buyback_due_ton = $self'buyback_due_ton + $msg'amount;
            $M20TFeeAccumulatorHarness$_contract_store(($self'run_id, $self'controller_address, $self'buyback_burn_address, $self'buyback_due_ton, $self'flush_count, $self'last_flush_amount));
            return ();
        }
        
        return ();
    }
    int op = 0;
    int in_msg_length = slice_bits(in_msg);
    if (in_msg_length >= 32) {
        op = in_msg~load_uint(32);
    }
    ;; Receive M20TFeeHarnessTopUp message
    if (op == 0x4d325446) {
        var $msg = empty_tuple();
        throw_unless(21101, ( equal_slices_bits(__tact_context_get_sender(), $self'controller_address) ));
        $M20TFeeAccumulatorHarness$_contract_store(($self'run_id, $self'controller_address, $self'buyback_burn_address, $self'buyback_due_ton, $self'flush_count, $self'last_flush_amount));
        return ();
    }
    
    ;; Receive FlushBuybackDue message
    if (op == 0xb3d2c52d) {
        var $msg'amount = in_msg~load_uint(128);
        throw_unless(21110, ( equal_slices_bits(__tact_context_get_sender(), $self'controller_address) ));
        throw_unless(21111, ($msg'amount > 0));
        throw_unless(21112, ($msg'amount == 51050000000));
        throw_unless(21113, ($msg'amount <= $self'buyback_due_ton));
        throw_unless(21114, ($Context$_get_value(__tact_context_get()) >= 3000000));
        $self'buyback_due_ton = $self'buyback_due_ton - $msg'amount;
        $self'flush_count = $self'flush_count + 1;
        $self'last_flush_amount = $msg'amount;
        $global_message($MessageParameters$_constructor_to_value_bounce_mode_body($self'buyback_burn_address, $msg'amount, true, 0, $AcceptBurnReserve$_store_cell($AcceptBurnReserve$_constructor_amount($msg'amount), begin_cell())));
        $M20TFeeAccumulatorHarness$_contract_store(($self'run_id, $self'controller_address, $self'buyback_burn_address, $self'buyback_due_ton, $self'flush_count, $self'last_flush_amount));
        return ();
    }
    
    ;; Receive M20TForwardWrongAcceptBurnReserve message
    if (op == 0x4d324657) {
        var $msg'amount = in_msg~load_uint(128);
        var $msg'forward_value = in_msg~load_uint(128);
        throw_unless(21120, ( equal_slices_bits(__tact_context_get_sender(), $self'controller_address) ));
        throw_unless(21121, ($Context$_get_value(__tact_context_get()) >= ($msg'forward_value + 3000000)));
        $global_message($MessageParameters$_constructor_to_value_bounce_mode_body($self'buyback_burn_address, $msg'forward_value, false, 0, $AcceptBurnReserve$_store_cell($AcceptBurnReserve$_constructor_amount($msg'amount), begin_cell())));
        $M20TFeeAccumulatorHarness$_contract_store(($self'run_id, $self'controller_address, $self'buyback_burn_address, $self'buyback_due_ton, $self'flush_count, $self'last_flush_amount));
        return ();
    }
    
    ;; Receive empty message
    if ((op == 0) & (in_msg_length <= 32)) {
        throw(21199);
        $M20TFeeAccumulatorHarness$_contract_store(($self'run_id, $self'controller_address, $self'buyback_burn_address, $self'buyback_due_ton, $self'flush_count, $self'last_flush_amount));
        return ();
    }
    ;; Throw if not handled
    throw(130);
