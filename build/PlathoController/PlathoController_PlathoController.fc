;; message opcode reader utility: only binary receivers
;; Returns 32 bit message opcode, otherwise throws the "Invalid incoming message" exit code
(slice, int) ~load_opcode_internal(slice s) asm( -> 1 0) "32 LDUQ 130 THROWIFNOT";

() recv_internal(int msg_value, cell in_msg_cell, slice in_msg) impure {
    
    ;; Context
    var cs = in_msg_cell.begin_parse();
    cs~skip_bits(2);
    var msg_bounceable = cs~load_int(1);
    var msg_bounced = cs~load_int(1);
    slice msg_sender_addr = cs~load_msg_addr();
    __tact_context = (msg_bounceable, msg_sender_addr, msg_value, cs);
    __tact_context_sender = msg_sender_addr;
    
    ;; Load contract data
    var ($self'signers, $self'nonce, $self'has_pending, $self'pending_kind, $self'pending_effective_at, $self'pending_manifest_hash, $self'pending_target_vault, $self'pending_successor_vault, $self'pending_rotate_slot, $self'pending_rotate_pubkey) = $PlathoController$_contract_load();
    
    ;; Handle bounced messages
    if (msg_bounced) { return (); }
    int op = 0;
    int in_msg_length = slice_bits(in_msg);
    if (in_msg_length >= 32) {
        op = in_msg~load_uint(32);
    }
    ;; Receive ControllerProposeSuccessor message
    if (op == 0xc0de0001) {
        var $msg'nonce = in_msg~load_uint(64);
        var $msg'target_vault = in_msg~load_msg_addr();
        var $msg'successor_manifest_hash = in_msg~load_uint(256);
        var $msg'successor_vault = in_msg~load_msg_addr();
        var $msg'approvals = in_msg~load_ref();
        int $paramHash = $Cell$_fun_hash($Builder$_fun_endCell($Builder$_fun_storeSlice(store_uint($Builder$_fun_storeSlice($global_beginCell(), $Address$_fun_asSlice($msg'target_vault)), $msg'successor_manifest_hash, 256), $Address$_fun_asSlice($msg'successor_vault))));
        throw_unless(25001, ($msg'nonce == $self'nonce));
        ($self'signers, $self'nonce, $self'has_pending, $self'pending_kind, $self'pending_effective_at, $self'pending_manifest_hash, $self'pending_target_vault, $self'pending_successor_vault, $self'pending_rotate_slot, $self'pending_rotate_pubkey)~$PlathoController$_fun_requireThreshold(($self'signers, $self'nonce, $self'has_pending, $self'pending_kind, $self'pending_effective_at, $self'pending_manifest_hash, $self'pending_target_vault, $self'pending_successor_vault, $self'pending_rotate_slot, $self'pending_rotate_pubkey)~$PlathoController$_fun_actionDigest(1, $paramHash), $msg'approvals);
        ($self'signers, $self'nonce, $self'has_pending, $self'pending_kind, $self'pending_effective_at, $self'pending_manifest_hash, $self'pending_target_vault, $self'pending_successor_vault, $self'pending_rotate_slot, $self'pending_rotate_pubkey)~$PlathoController$_fun_setPendingCommon(1);
        $self'pending_manifest_hash = $msg'successor_manifest_hash;
        $self'pending_target_vault = $msg'target_vault;
        $self'pending_successor_vault = $msg'successor_vault;
        $PlathoController$_contract_store(($self'signers, $self'nonce, $self'has_pending, $self'pending_kind, $self'pending_effective_at, $self'pending_manifest_hash, $self'pending_target_vault, $self'pending_successor_vault, $self'pending_rotate_slot, $self'pending_rotate_pubkey));
        return ();
    }
    
    ;; Receive ControllerProposeRotate message
    if (op == 0xc0de0002) {
        var $msg'nonce = in_msg~load_uint(64);
        var $msg'slot = in_msg~load_uint(8);
        var $msg'new_pubkey = in_msg~load_uint(256);
        var $msg'approvals = in_msg~load_ref();
        throw_unless(25002, ($msg'slot < 5));
        throw_unless(25003, ($msg'new_pubkey != 0));
        int $paramHash = $Cell$_fun_hash($Builder$_fun_endCell(store_uint(store_uint($global_beginCell(), $msg'slot, 8), $msg'new_pubkey, 256)));
        throw_unless(25004, ($msg'nonce == $self'nonce));
        ($self'signers, $self'nonce, $self'has_pending, $self'pending_kind, $self'pending_effective_at, $self'pending_manifest_hash, $self'pending_target_vault, $self'pending_successor_vault, $self'pending_rotate_slot, $self'pending_rotate_pubkey)~$PlathoController$_fun_requireThreshold(($self'signers, $self'nonce, $self'has_pending, $self'pending_kind, $self'pending_effective_at, $self'pending_manifest_hash, $self'pending_target_vault, $self'pending_successor_vault, $self'pending_rotate_slot, $self'pending_rotate_pubkey)~$PlathoController$_fun_actionDigest(2, $paramHash), $msg'approvals);
        ($self'signers, $self'nonce, $self'has_pending, $self'pending_kind, $self'pending_effective_at, $self'pending_manifest_hash, $self'pending_target_vault, $self'pending_successor_vault, $self'pending_rotate_slot, $self'pending_rotate_pubkey)~$PlathoController$_fun_setPendingCommon(2);
        $self'pending_rotate_slot = $msg'slot;
        $self'pending_rotate_pubkey = $msg'new_pubkey;
        $PlathoController$_contract_store(($self'signers, $self'nonce, $self'has_pending, $self'pending_kind, $self'pending_effective_at, $self'pending_manifest_hash, $self'pending_target_vault, $self'pending_successor_vault, $self'pending_rotate_slot, $self'pending_rotate_pubkey));
        return ();
    }
    
    ;; Receive ControllerProposeCancel message
    if (op == 0xc0de0003) {
        var $msg'nonce = in_msg~load_uint(64);
        var $msg'approvals = in_msg~load_ref();
        throw_unless(25005, $self'has_pending);
        throw_unless(25006, ($msg'nonce == $self'nonce));
        ($self'signers, $self'nonce, $self'has_pending, $self'pending_kind, $self'pending_effective_at, $self'pending_manifest_hash, $self'pending_target_vault, $self'pending_successor_vault, $self'pending_rotate_slot, $self'pending_rotate_pubkey)~$PlathoController$_fun_requireThreshold(($self'signers, $self'nonce, $self'has_pending, $self'pending_kind, $self'pending_effective_at, $self'pending_manifest_hash, $self'pending_target_vault, $self'pending_successor_vault, $self'pending_rotate_slot, $self'pending_rotate_pubkey)~$PlathoController$_fun_actionDigest(3, 0), $msg'approvals);
        $self'has_pending = false;
        $self'pending_kind = 0;
        $self'nonce = $self'nonce + 1;
        $PlathoController$_contract_store(($self'signers, $self'nonce, $self'has_pending, $self'pending_kind, $self'pending_effective_at, $self'pending_manifest_hash, $self'pending_target_vault, $self'pending_successor_vault, $self'pending_rotate_slot, $self'pending_rotate_pubkey));
        return ();
    }
    
    ;; Receive ControllerExecute message
    if (op == 0xc0de0004) {
        var $msg = empty_tuple();
        throw_unless(25030, $self'has_pending);
        throw_unless(25031, ($global_now() >= $self'pending_effective_at));
        if (($self'pending_kind == 1)) {
            $global_message($MessageParameters$_constructor_to_value_bounce_mode_body($self'pending_target_vault, 0, true, 64, $AnnounceSuccessorManifest$_store_cell($AnnounceSuccessorManifest$_constructor_successor_manifest_hash_successor_vault($self'pending_manifest_hash, $self'pending_successor_vault), begin_cell())));
        } elseif (($self'pending_kind == 2)) {
            $self'signers~__tact_dict_set_int_int(257, $self'pending_rotate_slot, $self'pending_rotate_pubkey, 257);
        }
        $self'has_pending = false;
        $self'pending_kind = 0;
        $PlathoController$_contract_store(($self'signers, $self'nonce, $self'has_pending, $self'pending_kind, $self'pending_effective_at, $self'pending_manifest_hash, $self'pending_target_vault, $self'pending_successor_vault, $self'pending_rotate_slot, $self'pending_rotate_pubkey));
        return ();
    }
    
    ;; Receive empty message
    if ((op == 0) & (in_msg_length <= 32)) {
        $PlathoController$_contract_store(($self'signers, $self'nonce, $self'has_pending, $self'pending_kind, $self'pending_effective_at, $self'pending_manifest_hash, $self'pending_target_vault, $self'pending_successor_vault, $self'pending_rotate_slot, $self'pending_rotate_pubkey));
        return ();
    }
    ;; Throw if not handled
