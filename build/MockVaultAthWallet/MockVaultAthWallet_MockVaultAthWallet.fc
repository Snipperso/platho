;;
;; Get methods of a Contract MockVaultAthWallet
;;

;;
;; Routing of a Contract MockVaultAthWallet
;;

;; message opcode reader utility: only binary receivers
;; Returns 32 bit message opcode, otherwise throws the "Invalid incoming message" exit code
(slice, int) ~load_opcode_internal(slice s) asm( -> 1 0) "32 LDUQ 130 THROWIFNOT";

() recv_internal(int msg_value, cell in_msg_cell, slice in_msg) impure {
    
    ;; Context
    var cs = in_msg_cell.begin_parse();
    cs~skip_bits(2);
    var msg_bounceable = cs~load_int(1);
    var msg_bounced = cs~load_int(1);
    slice msg_sender_addr = cs~load_msg_addr();
    __tact_context = (msg_bounceable, msg_sender_addr, msg_value, cs);
    __tact_context_sender = msg_sender_addr;
    
    ;; Load contract data
    var ($self'reject_transfers) = $MockVaultAthWallet$_contract_load();
    
    ;; Handle bounced messages
    if (msg_bounced) { return (); }
    int op = 0;
    int in_msg_length = slice_bits(in_msg);
    if (in_msg_length >= 32) {
        op = in_msg~load_uint(32);
    }
    ;; Receive MockSendAthDeposit message
    if (op == 0x4d415444) {
        var $msg'query_id = in_msg~load_uint(64);
        var $msg'vault = in_msg~load_msg_addr();
        var $msg'sender_wallet = in_msg~load_msg_addr();
        var $msg'amount = in_msg~load_uint(128);
        $global_message($MessageParameters$_constructor_to_value_bounce_mode_body($msg'vault, 0, true, 64, $AthTransferNotification$_store_cell($AthTransferNotification$_constructor_query_id_sender_key_amount_sender_wallet($msg'query_id, ($self'reject_transfers)~$MockVaultAthWallet$_fun_compute_sender_key($msg'sender_wallet), $msg'amount, $msg'sender_wallet), begin_cell())));
        
        return ();
    }
    
    ;; Receive VaultAthTransferRequest message
    if (op == 0x41544810) {
        var $msg'query_id = in_msg~load_uint(64);
        var $msg'amount = in_msg~load_uint(128);
        var $msg'recipient = in_msg~load_msg_addr();
        var $msg'response_destination = in_msg~load_msg_addr();
        throw_if(17000, $self'reject_transfers);
        $global_message($MessageParameters$_constructor_to_value_bounce_mode_body($msg'response_destination, 0, true, 64, $VaultAthTransferAck$_store_cell($VaultAthTransferAck$_constructor_query_id_amount($msg'query_id, $msg'amount), begin_cell())));
        
        return ();
    }
    
    ;; Receive empty message
    if ((op == 0) & (in_msg_length <= 32)) {
        throw(17001);
        
        return ();
    }
    ;; Throw if not handled
    throw(130);
}
