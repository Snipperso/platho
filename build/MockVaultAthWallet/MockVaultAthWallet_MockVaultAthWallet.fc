((int), int) $MockVaultAthWallet$_fun_compute_sender_key((int) $self, slice $sender_owner) impure inline_ref {
    var (($self'reject_transfers)) = $self;
    var $fresh$ret_0 = ($Cell$_fun_hash($Builder$_fun_endCell($Builder$_fun_storeAddress(store_uint($global_beginCell(), 1096044105, 32), $sender_owner))) % 4294967296);
    return (($self'reject_transfers), $fresh$ret_0);
