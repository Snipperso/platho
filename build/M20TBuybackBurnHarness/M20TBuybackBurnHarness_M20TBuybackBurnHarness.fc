;; message opcode reader utility: only binary receivers
;; Returns 32 bit message opcode, otherwise throws the "Invalid incoming message" exit code
(slice, int) ~load_opcode_internal(slice s) asm( -> 1 0) "32 LDUQ 130 THROWIFNOT";

() recv_internal(int msg_value, cell in_msg_cell, slice in_msg) impure {
    
    ;; Context
    var cs = in_msg_cell.begin_parse();
    cs~skip_bits(2);
    var msg_bounceable = cs~load_int(1);
    var msg_bounced = cs~load_int(1);
    slice msg_sender_addr = cs~load_msg_addr();
    __tact_context = (msg_bounceable, msg_sender_addr, msg_value, cs);
    __tact_context_sender = msg_sender_addr;
    
    ;; Load contract data
    var ($self'run_id, $self'genesis_controller_address, $self'fee_accumulator_address, $self'fee_bound, $self'accepted_count, $self'total_accepted, $self'last_amount) = $M20TBuybackBurnHarness$_contract_load();
    
    ;; Handle bounced messages
    if (msg_bounced) { return (); }
    int op = 0;
    int in_msg_length = slice_bits(in_msg);
    if (in_msg_length >= 32) {
        op = in_msg~load_uint(32);
    }
    ;; Receive M20TBindFeeAccumulator message
    if (op == 0x4d323042) {
        var $msg'fee_accumulator_address = in_msg~load_msg_addr();
        throw_unless(21000, ( equal_slices_bits(__tact_context_get_sender(), $self'genesis_controller_address) ));
        throw_unless(21001, (~ $self'fee_bound));
        throw_unless(21002, ( ~ equal_slices_bits($msg'fee_accumulator_address, $self'genesis_controller_address) ));
        $self'fee_accumulator_address = $msg'fee_accumulator_address;
        $self'fee_bound = true;
        $M20TBuybackBurnHarness$_contract_store(($self'run_id, $self'genesis_controller_address, $self'fee_accumulator_address, $self'fee_bound, $self'accepted_count, $self'total_accepted, $self'last_amount));
        return ();
    }
    
    ;; Receive M20TBuybackHarnessTopUp message
    if (op == 0x4d32544b) {
        var $msg = empty_tuple();
        throw_unless(21003, ( equal_slices_bits(__tact_context_get_sender(), $self'genesis_controller_address) ));
        $M20TBuybackBurnHarness$_contract_store(($self'run_id, $self'genesis_controller_address, $self'fee_accumulator_address, $self'fee_bound, $self'accepted_count, $self'total_accepted, $self'last_amount));
        return ();
    }
    
    ;; Receive AcceptBurnReserve message
    if (op == 0x594ba505) {
        var $msg'amount = in_msg~load_uint(128);
        throw_unless(21010, $self'fee_bound);
        throw_unless(21011, ( equal_slices_bits(__tact_context_get_sender(), $self'fee_accumulator_address) ));
        throw_unless(21012, ($msg'amount == 51050000000));
        throw_unless(21013, ($self'accepted_count == 0));
        $self'accepted_count = 1;
        $self'total_accepted = $msg'amount;
        $self'last_amount = $msg'amount;
        $M20TBuybackBurnHarness$_contract_store(($self'run_id, $self'genesis_controller_address, $self'fee_accumulator_address, $self'fee_bound, $self'accepted_count, $self'total_accepted, $self'last_amount));
        return ();
    }
    
    ;; Receive empty message
    if ((op == 0) & (in_msg_length <= 32)) {
        throw(21099);
        $M20TBuybackBurnHarness$_contract_store(($self'run_id, $self'genesis_controller_address, $self'fee_accumulator_address, $self'fee_bound, $self'accepted_count, $self'total_accepted, $self'last_amount));
        return ();
    }
    ;; Throw if not handled
    throw(130);
}
