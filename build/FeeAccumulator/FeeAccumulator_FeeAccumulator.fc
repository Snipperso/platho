        $self'treasury_due_ton = $self'treasury_due_ton - $msg'amount;
        $global_message($MessageParameters$_constructor_to_value_bounce_mode_body($self'treasury_receiver_address, $msg'amount, false, 1, null()));
        $FeeAccumulator$_contract_store(($self'treasury_receiver_address, $self'buyback_burn_address, $self'accumulated_ton, $self'treasury_due_ton, $self'buyback_due_ton, $self'buyback_split_enabled, $self'storage_reserve_ton, $self'shard_code, $self'intro_shard_code, $self'ticket_code, $self'airdrop_pool_address, $self'accrual_seq));
        return ();
    }
    
    ;; Receive FlushBuybackDue message
    if (op == 0xb3d2c52d) {
        var $msg'amount = in_msg~load_uint(128);
        throw_unless(15030, ($msg'amount > 0));
        throw_unless(15034, ($msg'amount == 51050000000));
        throw_unless(15031, ($msg'amount <= $self'buyback_due_ton));
        throw_unless(15035, ($Context$_get_value(__tact_context_get()) >= 7000000));
        $self'buyback_due_ton = $self'buyback_due_ton - $msg'amount;
        $global_message($MessageParameters$_constructor_to_value_bounce_mode_body($self'buyback_burn_address, ($msg'amount + 2000000), true, 1, $AcceptBurnReserve$_store_cell($AcceptBurnReserve$_constructor_amount($msg'amount), begin_cell())));
        $FeeAccumulator$_contract_store(($self'treasury_receiver_address, $self'buyback_burn_address, $self'accumulated_ton, $self'treasury_due_ton, $self'buyback_due_ton, $self'buyback_split_enabled, $self'storage_reserve_ton, $self'shard_code, $self'intro_shard_code, $self'ticket_code, $self'airdrop_pool_address, $self'accrual_seq));
        return ();
    }
    
    ;; Receive TopUpStorageReserve message
    if (op == 0x87a2d2c7) {
        var $msg = empty_tuple();
        $self'storage_reserve_ton = $self'storage_reserve_ton + $Context$_get_value(__tact_context_get());
        $FeeAccumulator$_contract_store(($self'treasury_receiver_address, $self'buyback_burn_address, $self'accumulated_ton, $self'treasury_due_ton, $self'buyback_due_ton, $self'buyback_split_enabled, $self'storage_reserve_ton, $self'shard_code, $self'intro_shard_code, $self'ticket_code, $self'airdrop_pool_address, $self'accrual_seq));
        return ();
    }
    
    ;; Receive SweepUnaccounted message
    if (op == 0x5357554e) {
        var $msg = empty_tuple();
        int $held = ($global_myBalance() - $Context$_get_value(__tact_context_get()));
        int $accounted = ((($self'accumulated_ton + $self'treasury_due_ton) + $self'buyback_due_ton) + $self'storage_reserve_ton);
        throw_unless(15040, ($held > ($accounted + 1000000)));
        $self'accumulated_ton = $self'accumulated_ton + (($held - $accounted) - 1000000);
        $global_nativeReserve($held, 2);
        $global_send($SendParameters$_constructor_to_value_mode_bounce(__tact_context_get_sender(), 0, 130, false));
        $FeeAccumulator$_contract_store(($self'treasury_receiver_address, $self'buyback_burn_address, $self'accumulated_ton, $self'treasury_due_ton, $self'buyback_due_ton, $self'buyback_split_enabled, $self'storage_reserve_ton, $self'shard_code, $self'intro_shard_code, $self'ticket_code, $self'airdrop_pool_address, $self'accrual_seq));
        return ();
    }
    
    ;; Receive empty message
    if ((op == 0) & (in_msg_length <= 32)) {
        throw(15099);
        $FeeAccumulator$_contract_store(($self'treasury_receiver_address, $self'buyback_burn_address, $self'accumulated_ton, $self'treasury_due_ton, $self'buyback_due_ton, $self'buyback_split_enabled, $self'storage_reserve_ton, $self'shard_code, $self'intro_shard_code, $self'ticket_code, $self'airdrop_pool_address, $self'accrual_seq));
        return ();
    }
    ;; Throw if not handled
    throw(130);
}
