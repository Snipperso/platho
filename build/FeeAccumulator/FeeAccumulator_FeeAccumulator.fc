;;
;; Type: FeeAccumulator
;; TLB: _ treasury_receiver_address:address buyback_burn_address:address accumulated_ton:uint128 treasury_due_ton:uint128 buyback_due_ton:uint128 = FeeAccumulator
;;

builder $FeeAccumulator$_store(builder build_0, (slice, slice, int, int, int) v) inline {
    var (v'treasury_receiver_address, v'buyback_burn_address, v'accumulated_ton, v'treasury_due_ton, v'buyback_due_ton) = v;
    build_0 = build_0.store_slice(v'treasury_receiver_address);
    build_0 = build_0.store_slice(v'buyback_burn_address);
    build_0 = build_0.store_uint(v'accumulated_ton, 128);
    build_0 = build_0.store_uint(v'treasury_due_ton, 128);
    build_0 = build_0.store_uint(v'buyback_due_ton, 128);
    return build_0;
}

(slice, ((slice, slice, int, int, int))) $FeeAccumulator$_load(slice sc_0) inline {
    var v'treasury_receiver_address = sc_0~load_msg_addr();
    var v'buyback_burn_address = sc_0~load_msg_addr();
