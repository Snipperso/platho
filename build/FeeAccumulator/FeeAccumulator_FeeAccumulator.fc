;; message opcode reader utility: only binary receivers
;; Returns 32 bit message opcode, otherwise throws the "Invalid incoming message" exit code
(slice, int) ~load_opcode_internal(slice s) asm( -> 1 0) "32 LDUQ 130 THROWIFNOT";

() recv_internal(int msg_value, cell in_msg_cell, slice in_msg) impure {
    
    ;; Context
    var cs = in_msg_cell.begin_parse();
    cs~skip_bits(2);
    var msg_bounceable = cs~load_int(1);
    var msg_bounced = cs~load_int(1);
    slice msg_sender_addr = cs~load_msg_addr();
    __tact_context = (msg_bounceable, msg_sender_addr, msg_value, cs);
    __tact_context_sender = msg_sender_addr;
    
    ;; Load contract data
    var ($self'treasury_receiver_address, $self'buyback_burn_address, $self'accumulated_ton, $self'treasury_due_ton, $self'buyback_due_ton, $self'buyback_split_enabled, $self'storage_reserve_ton) = $FeeAccumulator$_contract_load();
    
    ;; Handle bounced messages
    if (msg_bounced) {
        ;; Skip 0xFFFFFFFF prefix of a bounced message
        in_msg~skip_bits(32);
        int op = 0;
        if (slice_bits(in_msg) >= 32) {
            op = in_msg~load_uint(32);
        }
        ;; Bounced handler for AcceptBurnReserve message
        if (op == 0x594ba505) {
            var ($msg'amount) = in_msg~$AcceptBurnReserve$_load_bounced();
            throw_unless(15032, ( equal_slices_bits(__tact_context_get_sender(), $self'buyback_burn_address) ));
            throw_unless(15033, ($msg'amount > 0));
            $self'buyback_due_ton = $self'buyback_due_ton + $msg'amount;
            $FeeAccumulator$_contract_store(($self'treasury_receiver_address, $self'buyback_burn_address, $self'accumulated_ton, $self'treasury_due_ton, $self'buyback_due_ton, $self'buyback_split_enabled, $self'storage_reserve_ton));
            return ();
        }
        
        return ();
    }
    int op = 0;
    int in_msg_length = slice_bits(in_msg);
    if (in_msg_length >= 32) {
        op = in_msg~load_uint(32);
    }
    ;; Receive DepositProtocolFee message
    if (op == 0xff775609) {
        var $msg'amount = in_msg~load_uint(128);
        throw_unless(15001, ($msg'amount > 0));
        throw_unless(15002, ($Context$_get_value(__tact_context_get()) >= ($msg'amount + 400000)));
        $self'accumulated_ton = $self'accumulated_ton + $msg'amount;
        $FeeAccumulator$_contract_store(($self'treasury_receiver_address, $self'buyback_burn_address, $self'accumulated_ton, $self'treasury_due_ton, $self'buyback_due_ton, $self'buyback_split_enabled, $self'storage_reserve_ton));
        return ();
    }
    
    ;; Receive SplitAccumulated message
    if (op == 0x7b24ea03) {
        var $msg = empty_tuple();
        throw_unless(15010, ($self'accumulated_ton > 0));
        throw_unless(15011, ($Context$_get_value(__tact_context_get()) >= 2000000));
        int $amount = $self'accumulated_ton;
        ifnot ($self'buyback_split_enabled) {
            $self'accumulated_ton = 0;
            $self'treasury_due_ton = $self'treasury_due_ton + $amount;
            $FeeAccumulator$_contract_store(($self'treasury_receiver_address, $self'buyback_burn_address, $self'accumulated_ton, $self'treasury_due_ton, $self'buyback_due_ton, $self'buyback_split_enabled, $self'storage_reserve_ton));
            return ();
        }
        int $treasury_amount = (($amount * 5000) / 10000);
        int $buyback_amount = ($amount - $treasury_amount);
        $self'accumulated_ton = 0;
        $self'treasury_due_ton = $self'treasury_due_ton + $treasury_amount;
        $self'buyback_due_ton = $self'buyback_due_ton + $buyback_amount;
        $FeeAccumulator$_contract_store(($self'treasury_receiver_address, $self'buyback_burn_address, $self'accumulated_ton, $self'treasury_due_ton, $self'buyback_due_ton, $self'buyback_split_enabled, $self'storage_reserve_ton));
        return ();
    }
    
    ;; Receive EnableBuybackSplit message
    if (op == 0x8d8f2c18) {
        var $msg = empty_tuple();
        throw_unless(15012, ( equal_slices_bits(__tact_context_get_sender(), $self'treasury_receiver_address) ));
        throw_unless(15013, (~ $self'buyback_split_enabled));
        throw_unless(15014, ($Context$_get_value(__tact_context_get()) >= 2000000));
        if (($self'accumulated_ton > 0)) {
            $self'treasury_due_ton = $self'treasury_due_ton + $self'accumulated_ton;
            $self'accumulated_ton = 0;
        }
        $self'buyback_split_enabled = true;
        $FeeAccumulator$_contract_store(($self'treasury_receiver_address, $self'buyback_burn_address, $self'accumulated_ton, $self'treasury_due_ton, $self'buyback_due_ton, $self'buyback_split_enabled, $self'storage_reserve_ton));
        return ();
    }
    
    ;; Receive FlushTreasuryDue message
    if (op == 0xddab4641) {
        var $msg'amount = in_msg~load_uint(128);
        throw_unless(15020, ($msg'amount > 0));
        throw_unless(15021, ($msg'amount <= $self'treasury_due_ton));
        throw_unless(15023, ( (($msg'amount >= 5000000)) ? (true) : (($msg'amount == $self'treasury_due_ton)) ));
        throw_unless(15022, ($Context$_get_value(__tact_context_get()) >= 5000000));
        $self'treasury_due_ton = $self'treasury_due_ton - $msg'amount;
        $global_message($MessageParameters$_constructor_to_value_bounce_mode_body($self'treasury_receiver_address, $msg'amount, false, 1, null()));
        $FeeAccumulator$_contract_store(($self'treasury_receiver_address, $self'buyback_burn_address, $self'accumulated_ton, $self'treasury_due_ton, $self'buyback_due_ton, $self'buyback_split_enabled, $self'storage_reserve_ton));
        return ();
    }
    
    ;; Receive FlushBuybackDue message
    if (op == 0xb3d2c52d) {
        var $msg'amount = in_msg~load_uint(128);
        throw_unless(15030, ($msg'amount > 0));
        throw_unless(15034, ($msg'amount == 51050000000));
        throw_unless(15031, ($msg'amount <= $self'buyback_due_ton));
        throw_unless(15035, ($Context$_get_value(__tact_context_get()) >= 7000000));
        $self'buyback_due_ton = $self'buyback_due_ton - $msg'amount;
        $global_message($MessageParameters$_constructor_to_value_bounce_mode_body($self'buyback_burn_address, ($msg'amount + 2000000), true, 1, $AcceptBurnReserve$_store_cell($AcceptBurnReserve$_constructor_amount($msg'amount), begin_cell())));
        $FeeAccumulator$_contract_store(($self'treasury_receiver_address, $self'buyback_burn_address, $self'accumulated_ton, $self'treasury_due_ton, $self'buyback_due_ton, $self'buyback_split_enabled, $self'storage_reserve_ton));
        return ();
    }
    
    ;; Receive TopUpStorageReserve message
    if (op == 0x87a2d2c7) {
        var $msg = empty_tuple();
        $self'storage_reserve_ton = $self'storage_reserve_ton + $Context$_get_value(__tact_context_get());
        $FeeAccumulator$_contract_store(($self'treasury_receiver_address, $self'buyback_burn_address, $self'accumulated_ton, $self'treasury_due_ton, $self'buyback_due_ton, $self'buyback_split_enabled, $self'storage_reserve_ton));
        return ();
    }
    
    ;; Receive SweepUnaccounted message
    if (op == 0x5357554e) {
        var $msg = empty_tuple();
        int $held = ($global_myBalance() - $Context$_get_value(__tact_context_get()));
        int $accounted = ((($self'accumulated_ton + $self'treasury_due_ton) + $self'buyback_due_ton) + $self'storage_reserve_ton);
        throw_unless(15040, ($held > ($accounted + 1000000)));
        $self'accumulated_ton = $self'accumulated_ton + (($held - $accounted) - 1000000);
        $global_nativeReserve($held, 2);
        $global_send($SendParameters$_constructor_to_value_mode_bounce(__tact_context_get_sender(), 0, 130, false));
        $FeeAccumulator$_contract_store(($self'treasury_receiver_address, $self'buyback_burn_address, $self'accumulated_ton, $self'treasury_due_ton, $self'buyback_due_ton, $self'buyback_split_enabled, $self'storage_reserve_ton));
        return ();
    }
    
    ;; Receive empty message
    if ((op == 0) & (in_msg_length <= 32)) {
        throw(15099);
        $FeeAccumulator$_contract_store(($self'treasury_receiver_address, $self'buyback_burn_address, $self'accumulated_ton, $self'treasury_due_ton, $self'buyback_due_ton, $self'buyback_split_enabled, $self'storage_reserve_ton));
        return ();
    }
    ;; Throw if not handled
    throw(130);
}
