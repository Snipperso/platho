(slice, slice, int, int, int) $FeeAccumulator$_contract_init(slice $treasury_receiver_address, slice $buyback_burn_address) impure inline {
    var (($self'treasury_receiver_address, $self'buyback_burn_address, $self'accumulated_ton, $self'treasury_due_ton, $self'buyback_due_ton)) = (null(), null(), null(), null(), null());
    $self'treasury_receiver_address = $treasury_receiver_address;
    $self'buyback_burn_address = $buyback_burn_address;
    $self'accumulated_ton = 0;
    $self'treasury_due_ton = 0;
    $self'buyback_due_ton = 0;
