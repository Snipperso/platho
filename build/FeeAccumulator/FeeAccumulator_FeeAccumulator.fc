    return (sc_0, (v'treasury_receiver_address, v'buyback_burn_address));
}

(slice, slice, int, int, int) $FeeAccumulator$_contract_load() impure inline {
    slice $sc = get_data().begin_parse();
    int $loaded = $sc~load_int(1);
    if ($loaded) {
        return $sc~$FeeAccumulator$_load();
    }
    else {
        (slice $treasury_receiver_address, slice $buyback_burn_address) = $sc~$FeeAccumulator$init$_load();
        $sc.end_parse();
        return $FeeAccumulator$_contract_init($treasury_receiver_address, $buyback_burn_address);
    }
}

() $FeeAccumulator$_contract_store((slice, slice, int, int, int) v) impure inline {
    builder b = begin_cell();
    b = b.store_int(true, 1);
    b = $FeeAccumulator$_store(b, v);
