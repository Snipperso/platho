;;

builder $AcceptBurnReserve$_store(builder build_0, (int) v) inline {
    var (v'amount) = v;
    build_0 = store_uint(build_0, 1498129669, 32);
    build_0 = build_0.store_uint(v'amount, 128);
    return build_0;
}

cell $AcceptBurnReserve$_store_cell((int) v, builder b) inline {
    return $AcceptBurnReserve$_store(b, v).end_cell();
}

(slice, ((int))) $AcceptBurnReserve$_load_bounced(slice sc_0) inline {
