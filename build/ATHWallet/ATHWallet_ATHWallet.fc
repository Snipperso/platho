        var $msg'sender_key = in_msg~load_uint(160);
        throw_unless(14340, ( equal_slices_bits(__tact_context_get_sender(), $self'owner_address) ));
        throw_unless(14341, ($msg'amount > 0));
        int $pending_key = ($self'balance, $self'owner_address, $self'ath_master_address, $self'pending_notifications, $self'pending_outgoing_transfers)~$ATHWallet$_fun_compute_pending_notification_key($msg'query_id, $msg'sender_key);
        tuple $pendingOpt = $PendingAthTransferNotification$_load_opt(__tact_dict_get_int_cell($self'pending_notifications, 257, $pending_key));
        if (null?($pendingOpt)) {
            $ATHWallet$_contract_store(($self'balance, $self'owner_address, $self'ath_master_address, $self'pending_notifications, $self'pending_outgoing_transfers));
            return ();
        }
        var ($pending'sender_owner, $pending'response_destination, $pending'response_ack_value, $pending'amount, $pending'created_at) = $PendingAthTransferNotification$_not_null($pendingOpt);
        throw_unless(14343, ($pending'amount == $msg'amount));
        throw_unless(14344, (($self'balance, $self'owner_address, $self'ath_master_address, $self'pending_notifications, $self'pending_outgoing_transfers)~$ATHWallet$_fun_compute_sender_key($msg'query_id, $pending'sender_owner) == $msg'sender_key));
        $self'pending_notifications~__tact_dict_delete_int(257, $pending_key);
        $global_message($MessageParameters$_constructor_to_value_mode_bounce_body($pending'response_destination, $pending'response_ack_value, 1, false, $ATHTransferAck$_store_cell($ATHTransferAck$_constructor_query_id_amount($msg'query_id, $msg'amount), begin_cell())));
        $ATHWallet$_contract_store(($self'balance, $self'owner_address, $self'ath_master_address, $self'pending_notifications, $self'pending_outgoing_transfers));
        return ();
    }
    
    ;; Receive AthTransferNotificationRefund message
    if (op == 0x4154481e) {
        var $msg'query_id = in_msg~load_uint(64);
        var $msg'amount = in_msg~load_uint(128);
        var $msg'sender_key = in_msg~load_uint(160);
        throw_unless(14346, ( equal_slices_bits(__tact_context_get_sender(), $self'owner_address) ));
        ($self'balance, $self'owner_address, $self'ath_master_address, $self'pending_notifications, $self'pending_outgoing_transfers)~$ATHWallet$_fun_refund_pending_notification($msg'query_id, $msg'sender_key, $msg'amount);
        $ATHWallet$_contract_store(($self'balance, $self'owner_address, $self'ath_master_address, $self'pending_notifications, $self'pending_outgoing_transfers));
        return ();
    }
    
    ;; Receive PruneStaleNotification message
    if (op == 0x504e5052) {
        var $msg'query_id = in_msg~load_uint(64);
        var $msg'sender_key = in_msg~load_uint(160);
        throw_unless(14349, ($Context$_get_value(__tact_context_get()) >= 2000000));
        int $pending_key = ($self'balance, $self'owner_address, $self'ath_master_address, $self'pending_notifications, $self'pending_outgoing_transfers)~$ATHWallet$_fun_compute_pending_notification_key($msg'query_id, $msg'sender_key);
        tuple $pendingOpt = $PendingAthTransferNotification$_load_opt(__tact_dict_get_int_cell($self'pending_notifications, 257, $pending_key));
        throw_unless(14350, (~ null?($pendingOpt)));
        var ($pending'sender_owner, $pending'response_destination, $pending'response_ack_value, $pending'amount, $pending'created_at) = $PendingAthTransferNotification$_not_null($pendingOpt);
        throw_unless(14351, (($self'balance, $self'owner_address, $self'ath_master_address, $self'pending_notifications, $self'pending_outgoing_transfers)~$ATHWallet$_fun_compute_sender_key($msg'query_id, $pending'sender_owner) == $msg'sender_key));
        throw_unless(14352, ($global_now() >= ($pending'created_at + 86400)));
        throw_unless(14353, ($pending'response_ack_value != 3000000));
        $self'pending_notifications~__tact_dict_delete_int(257, $pending_key);
        $ATHWallet$_contract_store(($self'balance, $self'owner_address, $self'ath_master_address, $self'pending_notifications, $self'pending_outgoing_transfers));
        return ();
    }
    
    ;; Receive ATHWalletTopUpStorageReserve message
    if (op == 0x41544807) {
        var $msg = empty_tuple();
        $ATHWallet$_contract_store(($self'balance, $self'owner_address, $self'ath_master_address, $self'pending_notifications, $self'pending_outgoing_transfers));
        return ();
    }
    
    ;; Receive empty message
    if ((op == 0) & (in_msg_length <= 32)) {
        throw(13000);
        $ATHWallet$_contract_store(($self'balance, $self'owner_address, $self'ath_master_address, $self'pending_notifications, $self'pending_outgoing_transfers));
        return ();
    }
    ;; Throw if not handled
    throw(130);
}
