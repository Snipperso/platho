;; message opcode reader utility: only binary receivers
;; Returns 32 bit message opcode, otherwise throws the "Invalid incoming message" exit code
(slice, int) ~load_opcode_internal(slice s) asm( -> 1 0) "32 LDUQ 130 THROWIFNOT";

() recv_internal(int msg_value, cell in_msg_cell, slice in_msg) impure {
    
    ;; Context
    var cs = in_msg_cell.begin_parse();
    cs~skip_bits(2);
    var msg_bounceable = cs~load_int(1);
    var msg_bounced = cs~load_int(1);
    slice msg_sender_addr = cs~load_msg_addr();
    __tact_context = (msg_bounceable, msg_sender_addr, msg_value, cs);
    __tact_context_sender = msg_sender_addr;
    
    ;; Load contract data
    var ($self'ack_count, $self'last_publish_id, $self'last_entry_id, $self'last_entry_uid) = $MockVaultAckSink$_contract_load();
    
    ;; Handle bounced messages
    if (msg_bounced) { return (); }
    int op = 0;
    int in_msg_length = slice_bits(in_msg);
    if (in_msg_length >= 32) {
        op = in_msg~load_uint(32);
    }
    ;; Receive ForwardVaultPrivate message
    if (op == 0xfa001001) {
        var $msg'capsule_hub_address = in_msg~load_msg_addr();
        var $msg'bounce_id = in_msg~load_uint(64);
        var $msg'publish_id = in_msg~load_uint(256);
        var $msg'size_class = in_msg~load_uint(8);
        var $msg'crypto_suite = in_msg~load_uint(8);
        var $msg'header_0_hash = in_msg~load_uint(256);
        slice sc_1 = in_msg~load_ref().begin_parse();
        var $msg'header_1_hash = sc_1~load_uint(256);
        var $msg'body_hash = sc_1~load_uint(256);
        var $msg'protocol_fee_paid = sc_1~load_uint(128);
        var $msg'value_to_capsule = sc_1~load_uint(128);
        $global_message($MessageParameters$_constructor_to_value_bounce_mode_body($msg'capsule_hub_address, $msg'value_to_capsule, true, 0, $PublishPrivateFromVault$_store_cell($PublishPrivateFromVault$_constructor_bounce_id_publish_id_size_class_crypto_suite_header_0_hash_header_1_hash_body_hash_protocol_fee_paid($msg'bounce_id, $msg'publish_id, $msg'size_class, $msg'crypto_suite, $msg'header_0_hash, $msg'header_1_hash, $msg'body_hash, $msg'protocol_fee_paid), begin_cell())));
        $MockVaultAckSink$_contract_store(($self'ack_count, $self'last_publish_id, $self'last_entry_id, $self'last_entry_uid));
        return ();
    }
    
    ;; Receive ForwardVaultPublic message
    if (op == 0xfa001002) {
        var $msg'capsule_hub_address = in_msg~load_msg_addr();
        var $msg'bounce_id = in_msg~load_uint(64);
        var $msg'publish_id = in_msg~load_uint(256);
        var $msg'author_wallet = in_msg~load_msg_addr();
        slice sc_1 = in_msg~load_ref().begin_parse();
        var $msg'body_hash = sc_1~load_uint(256);
        var $msg'protocol_fee_paid = sc_1~load_uint(128);
        var $msg'value_to_capsule = sc_1~load_uint(128);
        $global_message($MessageParameters$_constructor_to_value_bounce_mode_body($msg'capsule_hub_address, $msg'value_to_capsule, true, 0, $PublishPublicFromVault$_store_cell($PublishPublicFromVault$_constructor_bounce_id_publish_id_author_wallet_body_hash_protocol_fee_paid($msg'bounce_id, $msg'publish_id, $msg'author_wallet, $msg'body_hash, $msg'protocol_fee_paid), begin_cell())));
        $MockVaultAckSink$_contract_store(($self'ack_count, $self'last_publish_id, $self'last_entry_id, $self'last_entry_uid));
        return ();
    }
    
    ;; Receive CapsuleHubPublishAck message
    if (op == 0x874e576a) {
        var $msg'publish_id = in_msg~load_uint(256);
        var $msg'entry_id = in_msg~load_uint(64);
        var $msg'entry_uid = in_msg~load_uint(256);
        $self'ack_count = $self'ack_count + 1;
        $self'last_publish_id = $msg'publish_id;
        $self'last_entry_id = $msg'entry_id;
        $self'last_entry_uid = $msg'entry_uid;
        $MockVaultAckSink$_contract_store(($self'ack_count, $self'last_publish_id, $self'last_entry_id, $self'last_entry_uid));
        return ();
    }
    
    ;; Receive empty message
    if ((op == 0) & (in_msg_length <= 32)) {
        throw(20999);
        $MockVaultAckSink$_contract_store(($self'ack_count, $self'last_publish_id, $self'last_entry_id, $self'last_entry_uid));
        return ();
    }
    ;; Throw if not handled
    throw(130);
}
