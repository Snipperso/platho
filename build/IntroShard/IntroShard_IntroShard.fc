;;
;; Routing of a Contract IntroShard
;;

;; message opcode reader utility: only binary receivers
;; Returns 32 bit message opcode, otherwise throws the "Invalid incoming message" exit code
(slice, int) ~load_opcode_internal(slice s) asm( -> 1 0) "32 LDUQ 130 THROWIFNOT";

() recv_internal(int msg_value, cell in_msg_cell, slice in_msg) impure {
    
    ;; Context
    var cs = in_msg_cell.begin_parse();
    cs~skip_bits(2);
    var msg_bounceable = cs~load_int(1);
    var msg_bounced = cs~load_int(1);
    slice msg_sender_addr = cs~load_msg_addr();
    __tact_context = (msg_bounceable, msg_sender_addr, msg_value, cs);
    __tact_context_sender = msg_sender_addr;
    
    ;; Load contract data
    var ($self'epoch, $self'bucket, $self'intros, $self'next_id, $self'live_count, $self'evict_cursor) = $IntroShard$_contract_load();
    
    ;; Handle bounced messages
    if (msg_bounced) { return (); }
    int op = 0;
    int in_msg_length = slice_bits(in_msg);
    if (in_msg_length >= 32) {
        op = in_msg~load_uint(32);
    }
    ;; Receive IntroStore message
    if (op == 0x49535032) {
        var $msg'serial = in_msg~load_uint(256);
        var $msg'r = in_msg~load_uint(256);
        var $msg'view_tag = in_msg~load_uint(16);
        var $msg'body_commit = in_msg~load_uint(256);
        int $lane = ($msg'serial % 1048576);
        throw_unless(13681, ( equal_slices_bits(__tact_context_get_sender(), $global_contractAddress($NullifierShard$_init_child($self'epoch, $lane))) ));
        throw_unless(13680, ($self'live_count < 8000));
        $self'intros~__tact_dict_set_int_cell(257, $self'next_id, $IntroEntry$_store_cell($IntroEntry$_constructor_r_view_tag_body_commit_created_at($msg'r, $msg'view_tag, $msg'body_commit, $global_now()), begin_cell()));
        $self'next_id = ($self'next_id + 1);
        $self'live_count = ($self'live_count + 1);
        $IntroShard$_contract_store(($self'epoch, $self'bucket, $self'intros, $self'next_id, $self'live_count, $self'evict_cursor));
        return ();
    }
    
    ;; Receive EvictIntros message
    if (op == 0x49535033) {
        var $msg'max_count = in_msg~load_uint(16);
        int $swept = 0;
        int $cursor = $self'evict_cursor;
        while (( (( (($swept < $msg'max_count)) ? (($swept < 64)) : (false) )) ? (($cursor < $self'next_id)) : (false) )) {
            tuple $e = $IntroEntry$_load_opt(__tact_dict_get_int_cell($self'intros, 257, $cursor));
            if ((~ null?($e))) {
                if ((($IntroEntry$_get_created_at($IntroEntry$_not_null($e)) + 604800) < $global_now())) {
                    $self'intros~__tact_dict_set_int_cell(257, $cursor, $IntroEntry$_store_opt(null(), begin_cell()));
                    $self'live_count = ($self'live_count - 1);
                    $cursor = ($cursor + 1);
                    $swept = ($swept + 1);
                } else {
                    $swept = $msg'max_count;
                }
            } else {
                $cursor = ($cursor + 1);
            }
        }
        $self'evict_cursor = $cursor;
        $IntroShard$_contract_store(($self'epoch, $self'bucket, $self'intros, $self'next_id, $self'live_count, $self'evict_cursor));
        return ();
    }
    
    ;; Receive empty message
    if ((op == 0) & (in_msg_length <= 32)) {
        $IntroShard$_contract_store(($self'epoch, $self'bucket, $self'intros, $self'next_id, $self'live_count, $self'evict_cursor));
        return ();
    }
    ;; Throw if not handled
    throw(130);
}
