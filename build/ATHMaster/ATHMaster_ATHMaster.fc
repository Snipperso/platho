;;
;; Routing of a Contract ATHMaster
;;

;; message opcode reader utility: only binary receivers
;; Returns 32 bit message opcode, otherwise throws the "Invalid incoming message" exit code
(slice, int) ~load_opcode_internal(slice s) asm( -> 1 0) "32 LDUQ 130 THROWIFNOT";

() recv_internal(int msg_value, cell in_msg_cell, slice in_msg) impure {
    
    ;; Context
    var cs = in_msg_cell.begin_parse();
    cs~skip_bits(2);
    var msg_bounceable = cs~load_int(1);
    var msg_bounced = cs~load_int(1);
    slice msg_sender_addr = cs~load_msg_addr();
    __tact_context = (msg_bounceable, msg_sender_addr, msg_value, cs);
    __tact_context_sender = msg_sender_addr;
    
    ;; Load contract data
    var ($self'total_supply, $self'treasury_owner, $self'content, $self'treasury_supply_deployed) = $ATHMaster$_contract_load();
    
    ;; Handle bounced messages
    if (msg_bounced) {
        ;; Skip 0xFFFFFFFF prefix of a bounced message
        in_msg~skip_bits(32);
        int op = 0;
        if (slice_bits(in_msg) >= 32) {
            op = in_msg~load_uint(32);
        }
        ;; Bounced handler for ATHGenesisSupplyCredit message
        if (op == 0x41544805) {
            var ($msg'query_id, $msg'amount) = in_msg~$ATHGenesisSupplyCredit$_load_bounced();
            throw_unless(14130, ( equal_slices_bits(__tact_context_get_sender(), ($self'total_supply, $self'treasury_owner, $self'content, $self'treasury_supply_deployed)~$ATHMaster$_fun_derive_wallet_address($self'treasury_owner)) ));
            throw_unless(14131, ($msg'amount == $self'total_supply));
            $self'treasury_supply_deployed = false;
            if (($Context$_get_value(__tact_context_get()) >= 100000)) {
                $global_message($MessageParameters$_constructor_to_value_bounce_mode_body($self'treasury_owner, 0, false, 64, null()));
            }
            $ATHMaster$_contract_store(($self'total_supply, $self'treasury_owner, $self'content, $self'treasury_supply_deployed));
            return ();
        }
        
        return ();
    }
    int op = 0;
    int in_msg_length = slice_bits(in_msg);
    if (in_msg_length >= 32) {
        op = in_msg~load_uint(32);
    }
    ;; Receive ATHBurnNotification message
    if (op == 0x41544802) {
        var $msg'query_id = in_msg~load_uint(64);
        var $msg'amount = in_msg~load_uint(128);
        var $msg'owner_address = in_msg~load_msg_addr();
        var $msg'response_destination = in_msg~load_msg_addr();
        throw_unless(14100, ($msg'amount > 0));
        throw_unless(14101, ( equal_slices_bits(__tact_context_get_sender(), ($self'total_supply, $self'treasury_owner, $self'content, $self'treasury_supply_deployed)~$ATHMaster$_fun_derive_wallet_address($msg'owner_address)) ));
        throw_unless(14102, ($self'total_supply >= $msg'amount));
        throw_unless(14103, ($Context$_get_value(__tact_context_get()) >= 2000000));
        $self'total_supply = $self'total_supply - $msg'amount;
        $global_message($MessageParameters$_constructor_to_value_mode_bounce_body($msg'response_destination, 0, 64, true, $ATHBurnFinalized$_store_cell($ATHBurnFinalized$_constructor_query_id_amount_owner_address($msg'query_id, $msg'amount, $msg'owner_address), begin_cell())));
        $ATHMaster$_contract_store(($self'total_supply, $self'treasury_owner, $self'content, $self'treasury_supply_deployed));
        return ();
    }
    
    ;; Receive DeployTreasurySupply message
    if (op == 0x41544807) {
        var $msg'query_id = in_msg~load_uint(64);
        var $msg'response_destination = in_msg~load_msg_addr();
        throw_unless(14120, ( equal_slices_bits(__tact_context_get_sender(), $self'treasury_owner) ));
        throw_unless(14121, (~ $self'treasury_supply_deployed));
        throw_unless(14122, ( equal_slices_bits($msg'response_destination, $self'treasury_owner) ));
        throw_unless(14123, ($self'total_supply == 100000000000000000));
        int $downstream_value = 3000000;
        int $required_value = ($downstream_value + 2000000);
        throw_unless(14124, ($Context$_get_value(__tact_context_get()) >= $required_value));
        $self'treasury_supply_deployed = true;
        var ($wallet_init'code, $wallet_init'data) = $ATHWallet$_init_child(0, $self'treasury_owner, $global_myAddress());
        slice $treasury_wallet = ($self'total_supply, $self'treasury_owner, $self'content, $self'treasury_supply_deployed)~$ATHMaster$_fun_derive_wallet_address($self'treasury_owner);
        $global_send($SendParameters$_constructor_to_value_bounce_mode_code_data_body($treasury_wallet, $downstream_value, true, 1, $wallet_init'code, $wallet_init'data, $ATHGenesisSupplyCredit$_store_cell($ATHGenesisSupplyCredit$_constructor_query_id_amount_response_destination($msg'query_id, $self'total_supply, $msg'response_destination), begin_cell())));
        int $excess = ($Context$_get_value(__tact_context_get()) - $required_value);
        if (($excess >= 100000)) {
            $global_message($MessageParameters$_constructor_to_value_bounce_mode_body($msg'response_destination, $excess, false, 0, null()));
        }
        $ATHMaster$_contract_store(($self'total_supply, $self'treasury_owner, $self'content, $self'treasury_supply_deployed));
        return ();
    }
    
    ;; Receive empty message
    if ((op == 0) & (in_msg_length <= 32)) {
        throw(13001);
        $ATHMaster$_contract_store(($self'total_supply, $self'treasury_owner, $self'content, $self'treasury_supply_deployed));
        return ();
    }
    ;; Throw if not handled
    throw(130);
}
