        $MarketStabilitySeller$_contract_store(($self'genesis_config_hash, $self'deployment_manifest_hash, $self'ath_master_address, $self'reserve_funder_address, $self'official_ath_wallet_address, $self'ton_treasury_receiver_address, $self'reserve_funder_bound, $self'official_ath_wallet_bound, $self'treasury_bound, $self'sealed, $self'phase, $self'reserve_due_ath, $self'treasury_due_ton, $self'pending_query_id, $self'pending_amount_ath, $self'pending_paid_ton, $self'pending_buyer, $self'pending_recipient, $self'pending_recipient_ath_wallet, $self'completed_tranche_count, $self'current_tranche_sold_ath, $self'last_terminal_query_id, $self'reserve_funded_total_ath, $self'sold_ath_total, $self'treasury_flushed_ton_total));
        return ();
    }
    
    ;; Receive FlushMarketStabilityTreasuryTon message
    if (op == 0x4d534654) {
        var $msg'amount = in_msg~load_uint(128);
        ($self'genesis_config_hash, $self'deployment_manifest_hash, $self'ath_master_address, $self'reserve_funder_address, $self'official_ath_wallet_address, $self'ton_treasury_receiver_address, $self'reserve_funder_bound, $self'official_ath_wallet_bound, $self'treasury_bound, $self'sealed, $self'phase, $self'reserve_due_ath, $self'treasury_due_ton, $self'pending_query_id, $self'pending_amount_ath, $self'pending_paid_ton, $self'pending_buyer, $self'pending_recipient, $self'pending_recipient_ath_wallet, $self'completed_tranche_count, $self'current_tranche_sold_ath, $self'last_terminal_query_id, $self'reserve_funded_total_ath, $self'sold_ath_total, $self'treasury_flushed_ton_total)~$MarketStabilitySeller$_fun_requireSealed();
        throw_unless(23260, ($msg'amount > 0));
        throw_unless(23261, ($msg'amount <= $self'treasury_due_ton));
        throw_unless(23263, ( (($msg'amount >= 2000000)) ? (true) : (($msg'amount == $self'treasury_due_ton)) ));
        throw_unless(23262, ($Context$_get_value(__tact_context_get()) >= 2000000));
        $self'treasury_due_ton = $self'treasury_due_ton - $msg'amount;
        $self'treasury_flushed_ton_total = $self'treasury_flushed_ton_total + $msg'amount;
        $global_message($MessageParameters$_constructor_to_value_bounce_mode_body($self'ton_treasury_receiver_address, $msg'amount, false, 1, null()));
        $global_message($MessageParameters$_constructor_to_value_bounce_mode_body(__tact_context_get_sender(), 0, false, 66, null()));
        $MarketStabilitySeller$_contract_store(($self'genesis_config_hash, $self'deployment_manifest_hash, $self'ath_master_address, $self'reserve_funder_address, $self'official_ath_wallet_address, $self'ton_treasury_receiver_address, $self'reserve_funder_bound, $self'official_ath_wallet_bound, $self'treasury_bound, $self'sealed, $self'phase, $self'reserve_due_ath, $self'treasury_due_ton, $self'pending_query_id, $self'pending_amount_ath, $self'pending_paid_ton, $self'pending_buyer, $self'pending_recipient, $self'pending_recipient_ath_wallet, $self'completed_tranche_count, $self'current_tranche_sold_ath, $self'last_terminal_query_id, $self'reserve_funded_total_ath, $self'sold_ath_total, $self'treasury_flushed_ton_total));
        return ();
    }
    
    ;; Receive MarketStabilityTopUpStorageReserve message
    if (op == 0x906182d3) {
        var $msg = empty_tuple();
        $MarketStabilitySeller$_contract_store(($self'genesis_config_hash, $self'deployment_manifest_hash, $self'ath_master_address, $self'reserve_funder_address, $self'official_ath_wallet_address, $self'ton_treasury_receiver_address, $self'reserve_funder_bound, $self'official_ath_wallet_bound, $self'treasury_bound, $self'sealed, $self'phase, $self'reserve_due_ath, $self'treasury_due_ton, $self'pending_query_id, $self'pending_amount_ath, $self'pending_paid_ton, $self'pending_buyer, $self'pending_recipient, $self'pending_recipient_ath_wallet, $self'completed_tranche_count, $self'current_tranche_sold_ath, $self'last_terminal_query_id, $self'reserve_funded_total_ath, $self'sold_ath_total, $self'treasury_flushed_ton_total));
        return ();
    }
    
    ;; Receive empty message
    if ((op == 0) & (in_msg_length <= 32)) {
        throw(23999);
        $MarketStabilitySeller$_contract_store(($self'genesis_config_hash, $self'deployment_manifest_hash, $self'ath_master_address, $self'reserve_funder_address, $self'official_ath_wallet_address, $self'ton_treasury_receiver_address, $self'reserve_funder_bound, $self'official_ath_wallet_bound, $self'treasury_bound, $self'sealed, $self'phase, $self'reserve_due_ath, $self'treasury_due_ton, $self'pending_query_id, $self'pending_amount_ath, $self'pending_paid_ton, $self'pending_buyer, $self'pending_recipient, $self'pending_recipient_ath_wallet, $self'completed_tranche_count, $self'current_tranche_sold_ath, $self'last_terminal_query_id, $self'reserve_funded_total_ath, $self'sold_ath_total, $self'treasury_flushed_ton_total));
        return ();
    }
    ;; Throw if not handled
    throw(130);
}
