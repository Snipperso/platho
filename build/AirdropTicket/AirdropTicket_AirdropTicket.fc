;;
;; Routing of a Contract AirdropTicket
;;

;; message opcode reader utility: binary receivers and empty fallback receiver
;; Returns 32 bit message opcode, or returns immediately if the message is shorter than 32 bits
(slice, int) ~load_opcode_internal(slice s) asm( -> 1 0) "32 LDUQ IFNOTRET";

() recv_internal(int msg_value, cell in_msg_cell, slice in_msg) impure {
    
    ;; Context
    var cs = in_msg_cell.begin_parse();
    cs~skip_bits(2);
    var msg_bounceable = cs~load_int(1);
    var msg_bounced = cs~load_int(1);
    slice msg_sender_addr = cs~load_msg_addr();
    __tact_context = (msg_bounceable, msg_sender_addr, msg_value, cs);
    __tact_context_sender = msg_sender_addr;
    
    ;; Load contract data
    var ($self'owner, $self'credits, $self'in_flight) = $AirdropTicket$_contract_load();
    
    ;; Handle bounced messages
    if (msg_bounced) {
        ;; Skip 0xFFFFFFFF prefix of a bounced message
        in_msg~skip_bits(32);
        int op = 0;
        if (slice_bits(in_msg) >= 32) {
            op = in_msg~load_uint(32);
        }
        ;; Bounced handler for TicketRedeem message
        if (op == 0x41544333) {
            var ($msg'credits_k) = in_msg~$TicketRedeem$_load_bounced();
            $self'credits = $self'credits + $msg'credits_k;
            $self'in_flight = 0;
            $AirdropTicket$_contract_store(($self'owner, $self'credits, $self'in_flight));
            return ();
        }
        
        return ();
    }
    int op = 0;
    int in_msg_length = slice_bits(in_msg);
    if (in_msg_length >= 32) {
        op = in_msg.preload_uint(32);
    }
    ;; Receive TicketCredit message
    if (op == 0x41544331) {
        in_msg~skip_bits(32);
        var $_ = empty_tuple();
        throw_unless(27001, ( equal_slices_bits(__tact_context_get_sender(), __gen_slice_address_a12b050296d57b9749c31ebe3c3674122902f0dd6f2efb8070698bac3b62bd6b()) ));
        throw_unless(27002, ($self'credits < 4294967295));
        $self'credits = $self'credits + 1;
        $AirdropTicket$_contract_store(($self'owner, $self'credits, $self'in_flight));
        return ();
    }
    
    ;; Receive TicketClaim message
    if (op == 0x41544332) {
        in_msg~skip_bits(32);
        var $_ = empty_tuple();
        throw_unless(27010, ( equal_slices_bits(__tact_context_get_sender(), $self'owner) ));
        throw_unless(27011, ($self'in_flight == 0));
        throw_unless(27012, ($self'credits >= 64));
        throw_unless(27013, ($Context$_get_value(__tact_context_get()) >= 63000000));
        int $k = $self'credits;
        if (($k > 1000)) {
            $k = 1000;
        }
        $self'credits = $self'credits - $k;
        $self'in_flight = $k;
        $global_message($MessageParameters$_constructor_to_value_mode_bounce_body(__gen_slice_address_a12b050296d57b9749c31ebe3c3674122902f0dd6f2efb8070698bac3b62bd6b(), 0, 64, true, $TicketRedeem$_store_cell($TicketRedeem$_constructor_credits_k_owner($k, $self'owner), begin_cell())));
        $AirdropTicket$_contract_store(($self'owner, $self'credits, $self'in_flight));
        return ();
    }
    
    ;; Receive TicketRedeemAck message
    if (op == 0x41544334) {
        in_msg~skip_bits(32);
        var $_'credits_k = in_msg~load_uint(32);
        throw_unless(27020, ( equal_slices_bits(__tact_context_get_sender(), __gen_slice_address_a12b050296d57b9749c31ebe3c3674122902f0dd6f2efb8070698bac3b62bd6b()) ));
        $self'in_flight = 0;
        $AirdropTicket$_contract_store(($self'owner, $self'credits, $self'in_flight));
        return ();
    }
    
    ;; Receive empty message
    if ((op == 0) & (in_msg_length <= 32)) {
        $AirdropTicket$_contract_store(($self'owner, $self'credits, $self'in_flight));
        return ();
    }
    ;; Receiver fallback
    $AirdropTicket$_contract_store(($self'owner, $self'credits, $self'in_flight));
}
