;; message opcode reader utility: only binary receivers
;; Returns 32 bit message opcode, otherwise throws the "Invalid incoming message" exit code
(slice, int) ~load_opcode_internal(slice s) asm( -> 1 0) "32 LDUQ 130 THROWIFNOT";

() recv_internal(int msg_value, cell in_msg_cell, slice in_msg) impure {
    
    ;; Context
    var cs = in_msg_cell.begin_parse();
    cs~skip_bits(2);
    var msg_bounceable = cs~load_int(1);
    var msg_bounced = cs~load_int(1);
    slice msg_sender_addr = cs~load_msg_addr();
    __tact_context = (msg_bounceable, msg_sender_addr, msg_value, cs);
    __tact_context_sender = msg_sender_addr;
    
    ;; Load contract data
    var ($self'sealed, $self'genesis_controller_address, $self'deployment_manifest_hash, $self'genesis_config_hash, $self'issuer_slot_count, $self'active_slot_count, $self'issuer_slots, $self'credit_price, $self'pool_collected, $self'credits_sold, $self'capsule_hub_address, $self'hub_bound, $self'pending_purchases, $self'purchase_seq, $self'airdrop_pool_address, $self'airdrop_pool_bound) = $CreditIssuer$_contract_load();
    
    ;; Handle bounced messages
    if (msg_bounced) {
        ;; Skip 0xFFFFFFFF prefix of a bounced message
        in_msg~skip_bits(32);
        int op = 0;
        if (slice_bits(in_msg) >= 32) {
            op = in_msg~load_uint(32);
        }
        ;; Bounced handler for FundAnonPool message
        if (op == 0x46414e50) {
            var ($msg'credits_k, $msg'epoch, $msg'purchase_id) = in_msg~$FundAnonPool$_load_bounced();
            tuple $pOpt = $PendingPurchase$_load_opt(__tact_dict_get_int_cell($self'pending_purchases, 257, $msg'purchase_id));
            if ((~ null?($pOpt))) {
                var ($p'payer, $p'credits_k, $p'refund_amount) = $PendingPurchase$_not_null($pOpt);
                $self'pending_purchases~__tact_dict_set_int_cell(257, $msg'purchase_id, $PendingPurchase$_store_opt(null(), begin_cell()));
                if (($self'credits_sold >= $p'credits_k)) {
                    $self'credits_sold = $self'credits_sold - $p'credits_k;
                }
                if (($self'pool_collected >= $p'refund_amount)) {
                    $self'pool_collected = $self'pool_collected - $p'refund_amount;
                }
                $global_message($MessageParameters$_constructor_to_value_bounce_mode_body($p'payer, $p'refund_amount, false, 0, $CreditPurchaseRefund$_store_cell($CreditPurchaseRefund$_constructor_purchase_id_credits_k($msg'purchase_id, $p'credits_k), begin_cell())));
            }
            $CreditIssuer$_contract_store(($self'sealed, $self'genesis_controller_address, $self'deployment_manifest_hash, $self'genesis_config_hash, $self'issuer_slot_count, $self'active_slot_count, $self'issuer_slots, $self'credit_price, $self'pool_collected, $self'credits_sold, $self'capsule_hub_address, $self'hub_bound, $self'pending_purchases, $self'purchase_seq, $self'airdrop_pool_address, $self'airdrop_pool_bound));
            return ();
        }
        
        return ();
    }
    int op = 0;
    int in_msg_length = slice_bits(in_msg);
    if (in_msg_length >= 32) {
        op = in_msg~load_uint(32);
    }
    ;; Receive CreditBindHub message
    if (op == 0x43524436) {
        var $msg'capsule_hub_address = in_msg~load_msg_addr();
        ($self'sealed, $self'genesis_controller_address, $self'deployment_manifest_hash, $self'genesis_config_hash, $self'issuer_slot_count, $self'active_slot_count, $self'issuer_slots, $self'credit_price, $self'pool_collected, $self'credits_sold, $self'capsule_hub_address, $self'hub_bound, $self'pending_purchases, $self'purchase_seq, $self'airdrop_pool_address, $self'airdrop_pool_bound)~$CreditIssuer$_fun_requireUnsealed();
        ($self'sealed, $self'genesis_controller_address, $self'deployment_manifest_hash, $self'genesis_config_hash, $self'issuer_slot_count, $self'active_slot_count, $self'issuer_slots, $self'credit_price, $self'pool_collected, $self'credits_sold, $self'capsule_hub_address, $self'hub_bound, $self'pending_purchases, $self'purchase_seq, $self'airdrop_pool_address, $self'airdrop_pool_bound)~$CreditIssuer$_fun_requireGenesisController();
        throw_unless(21070, ($self'sealed, $self'genesis_controller_address, $self'deployment_manifest_hash, $self'genesis_config_hash, $self'issuer_slot_count, $self'active_slot_count, $self'issuer_slots, $self'credit_price, $self'pool_collected, $self'credits_sold, $self'capsule_hub_address, $self'hub_bound, $self'pending_purchases, $self'purchase_seq, $self'airdrop_pool_address, $self'airdrop_pool_bound)~$CreditIssuer$_fun_isBasechainAddress($msg'capsule_hub_address));
        throw_unless(21071, ( ~ equal_slices_bits($msg'capsule_hub_address, $global_myAddress()) ));
        $self'capsule_hub_address = $msg'capsule_hub_address;
        $self'hub_bound = true;
        $CreditIssuer$_contract_store(($self'sealed, $self'genesis_controller_address, $self'deployment_manifest_hash, $self'genesis_config_hash, $self'issuer_slot_count, $self'active_slot_count, $self'issuer_slots, $self'credit_price, $self'pool_collected, $self'credits_sold, $self'capsule_hub_address, $self'hub_bound, $self'pending_purchases, $self'purchase_seq, $self'airdrop_pool_address, $self'airdrop_pool_bound));
        return ();
    }
    
    ;; Receive CreditUploadIssuerKey message
    if (op == 0x43524431) {
        var $msg'slot = in_msg~load_uint(8);
        var $msg'pubkey = in_msg~load_uint(256);
        ($self'sealed, $self'genesis_controller_address, $self'deployment_manifest_hash, $self'genesis_config_hash, $self'issuer_slot_count, $self'active_slot_count, $self'issuer_slots, $self'credit_price, $self'pool_collected, $self'credits_sold, $self'capsule_hub_address, $self'hub_bound, $self'pending_purchases, $self'purchase_seq, $self'airdrop_pool_address, $self'airdrop_pool_bound)~$CreditIssuer$_fun_requireUnsealed();
        ($self'sealed, $self'genesis_controller_address, $self'deployment_manifest_hash, $self'genesis_config_hash, $self'issuer_slot_count, $self'active_slot_count, $self'issuer_slots, $self'credit_price, $self'pool_collected, $self'credits_sold, $self'capsule_hub_address, $self'hub_bound, $self'pending_purchases, $self'purchase_seq, $self'airdrop_pool_address, $self'airdrop_pool_bound)~$CreditIssuer$_fun_requireGenesisController();
        throw_unless(21010, ($msg'slot < 16));
        throw_unless(21011, ($msg'pubkey != 0));
        throw_unless(21012, (~ __tact_dict_exists_int($self'issuer_slots, 257, $msg'slot)));
        $self'issuer_slots~__tact_dict_set_int_cell(257, $msg'slot, $IssuerSlot$_store_cell($IssuerSlot$_constructor_pubkey_active_version($msg'pubkey, true, 0), begin_cell()));
        $self'issuer_slot_count = $self'issuer_slot_count + 1;
        $self'active_slot_count = $self'active_slot_count + 1;
        $CreditIssuer$_contract_store(($self'sealed, $self'genesis_controller_address, $self'deployment_manifest_hash, $self'genesis_config_hash, $self'issuer_slot_count, $self'active_slot_count, $self'issuer_slots, $self'credit_price, $self'pool_collected, $self'credits_sold, $self'capsule_hub_address, $self'hub_bound, $self'pending_purchases, $self'purchase_seq, $self'airdrop_pool_address, $self'airdrop_pool_bound));
        return ();
    }
    
    ;; Receive CreditSetPrice message
    if (op == 0x43524432) {
        var $msg'credit_price = in_msg~load_uint(128);
        ($self'sealed, $self'genesis_controller_address, $self'deployment_manifest_hash, $self'genesis_config_hash, $self'issuer_slot_count, $self'active_slot_count, $self'issuer_slots, $self'credit_price, $self'pool_collected, $self'credits_sold, $self'capsule_hub_address, $self'hub_bound, $self'pending_purchases, $self'purchase_seq, $self'airdrop_pool_address, $self'airdrop_pool_bound)~$CreditIssuer$_fun_requireUnsealed();
        ($self'sealed, $self'genesis_controller_address, $self'deployment_manifest_hash, $self'genesis_config_hash, $self'issuer_slot_count, $self'active_slot_count, $self'issuer_slots, $self'credit_price, $self'pool_collected, $self'credits_sold, $self'capsule_hub_address, $self'hub_bound, $self'pending_purchases, $self'purchase_seq, $self'airdrop_pool_address, $self'airdrop_pool_bound)~$CreditIssuer$_fun_requireGenesisController();
        throw_unless(21013, ($msg'credit_price > 0));
        $self'credit_price = $msg'credit_price;
        $CreditIssuer$_contract_store(($self'sealed, $self'genesis_controller_address, $self'deployment_manifest_hash, $self'genesis_config_hash, $self'issuer_slot_count, $self'active_slot_count, $self'issuer_slots, $self'credit_price, $self'pool_collected, $self'credits_sold, $self'capsule_hub_address, $self'hub_bound, $self'pending_purchases, $self'purchase_seq, $self'airdrop_pool_address, $self'airdrop_pool_bound));
        return ();
    }
    
    ;; Receive CreditSealGenesis message
    if (op == 0x3a12d1ad) {
        var $msg'deployment_manifest_hash = in_msg~load_uint(256);
        ($self'sealed, $self'genesis_controller_address, $self'deployment_manifest_hash, $self'genesis_config_hash, $self'issuer_slot_count, $self'active_slot_count, $self'issuer_slots, $self'credit_price, $self'pool_collected, $self'credits_sold, $self'capsule_hub_address, $self'hub_bound, $self'pending_purchases, $self'purchase_seq, $self'airdrop_pool_address, $self'airdrop_pool_bound)~$CreditIssuer$_fun_requireUnsealed();
        ($self'sealed, $self'genesis_controller_address, $self'deployment_manifest_hash, $self'genesis_config_hash, $self'issuer_slot_count, $self'active_slot_count, $self'issuer_slots, $self'credit_price, $self'pool_collected, $self'credits_sold, $self'capsule_hub_address, $self'hub_bound, $self'pending_purchases, $self'purchase_seq, $self'airdrop_pool_address, $self'airdrop_pool_bound)~$CreditIssuer$_fun_requireGenesisController();
        throw_unless(21040, ($msg'deployment_manifest_hash > 1));
        throw_unless(21041, ($self'deployment_manifest_hash == $msg'deployment_manifest_hash));
        throw_unless(21042, ($self'issuer_slot_count >= 8));
        throw_unless(21043, ($self'issuer_slot_count <= 16));
        throw_unless(21044, ($self'active_slot_count >= 8));
        throw_unless(21045, ($self'credit_price > 0));
        throw_unless(21046, $self'hub_bound);
        throw_unless(21047, ($self'credit_price >= 10995000));
        $self'genesis_config_hash = $msg'deployment_manifest_hash;
        $self'sealed = true;
        $CreditIssuer$_contract_store(($self'sealed, $self'genesis_controller_address, $self'deployment_manifest_hash, $self'genesis_config_hash, $self'issuer_slot_count, $self'active_slot_count, $self'issuer_slots, $self'credit_price, $self'pool_collected, $self'credits_sold, $self'capsule_hub_address, $self'hub_bound, $self'pending_purchases, $self'purchase_seq, $self'airdrop_pool_address, $self'airdrop_pool_bound));
        return ();
    }
    
    ;; Receive CreditReplaceIssuerKey message
    if (op == 0x43524433) {
        var $msg'slot = in_msg~load_uint(8);
        var $msg'new_pubkey = in_msg~load_uint(256);
        ($self'sealed, $self'genesis_controller_address, $self'deployment_manifest_hash, $self'genesis_config_hash, $self'issuer_slot_count, $self'active_slot_count, $self'issuer_slots, $self'credit_price, $self'pool_collected, $self'credits_sold, $self'capsule_hub_address, $self'hub_bound, $self'pending_purchases, $self'purchase_seq, $self'airdrop_pool_address, $self'airdrop_pool_bound)~$CreditIssuer$_fun_requireGenesisController();
        throw_unless(21050, ($msg'new_pubkey != 0));
        tuple $slotOpt = $IssuerSlot$_load_opt(__tact_dict_get_int_cell($self'issuer_slots, 257, $msg'slot));
        throw_unless(21051, (~ null?($slotOpt)));
        var ($slot'pubkey, $slot'active, $slot'version) = $IssuerSlot$_not_null($slotOpt);
        ifnot ($slot'active) {
            $self'active_slot_count = $self'active_slot_count + 1;
        }
        $self'issuer_slots~__tact_dict_set_int_cell(257, $msg'slot, $IssuerSlot$_store_cell($IssuerSlot$_constructor_pubkey_active_version($msg'new_pubkey, true, ($slot'version + 1)), begin_cell()));
        $CreditIssuer$_contract_store(($self'sealed, $self'genesis_controller_address, $self'deployment_manifest_hash, $self'genesis_config_hash, $self'issuer_slot_count, $self'active_slot_count, $self'issuer_slots, $self'credit_price, $self'pool_collected, $self'credits_sold, $self'capsule_hub_address, $self'hub_bound, $self'pending_purchases, $self'purchase_seq, $self'airdrop_pool_address, $self'airdrop_pool_bound));
        return ();
    }
    
    ;; Receive CreditRevokeIssuerKey message
    if (op == 0x43524434) {
        var $msg'slot = in_msg~load_uint(8);
        ($self'sealed, $self'genesis_controller_address, $self'deployment_manifest_hash, $self'genesis_config_hash, $self'issuer_slot_count, $self'active_slot_count, $self'issuer_slots, $self'credit_price, $self'pool_collected, $self'credits_sold, $self'capsule_hub_address, $self'hub_bound, $self'pending_purchases, $self'purchase_seq, $self'airdrop_pool_address, $self'airdrop_pool_bound)~$CreditIssuer$_fun_requireGenesisController();
        tuple $slotOpt = $IssuerSlot$_load_opt(__tact_dict_get_int_cell($self'issuer_slots, 257, $msg'slot));
        throw_unless(21055, (~ null?($slotOpt)));
        var ($slot'pubkey, $slot'active, $slot'version) = $IssuerSlot$_not_null($slotOpt);
        throw_unless(21056, $slot'active);
        $self'active_slot_count = $self'active_slot_count - 1;
        $self'issuer_slots~__tact_dict_set_int_cell(257, $msg'slot, $IssuerSlot$_store_cell($IssuerSlot$_constructor_pubkey_active_version($slot'pubkey, false, ($slot'version + 1)), begin_cell()));
        $CreditIssuer$_contract_store(($self'sealed, $self'genesis_controller_address, $self'deployment_manifest_hash, $self'genesis_config_hash, $self'issuer_slot_count, $self'active_slot_count, $self'issuer_slots, $self'credit_price, $self'pool_collected, $self'credits_sold, $self'capsule_hub_address, $self'hub_bound, $self'pending_purchases, $self'purchase_seq, $self'airdrop_pool_address, $self'airdrop_pool_bound));
        return ();
    }
    
    ;; Receive CreditBuyCredits message
    if (op == 0x43524435) {
        var $msg'credits_k = in_msg~load_uint(16);
        var $msg'redeem_pubkey = in_msg~load_uint(256);
        var $msg'epoch = in_msg~load_uint(32);
        ($self'sealed, $self'genesis_controller_address, $self'deployment_manifest_hash, $self'genesis_config_hash, $self'issuer_slot_count, $self'active_slot_count, $self'issuer_slots, $self'credit_price, $self'pool_collected, $self'credits_sold, $self'capsule_hub_address, $self'hub_bound, $self'pending_purchases, $self'purchase_seq, $self'airdrop_pool_address, $self'airdrop_pool_bound)~$CreditIssuer$_fun_requireSealed();
        throw_unless(21060, ($msg'credits_k >= 1));
        throw_unless(21061, ($msg'credits_k <= 1000));
        throw_unless(21062, ($msg'redeem_pubkey != 0));
        int $creditCost = ($msg'credits_k * $self'credit_price);
        int $required = (($creditCost + 10000000) + 10000000);
        throw_unless(21063, ($Context$_get_value(__tact_context_get()) >= $required));
        $self'pool_collected = $self'pool_collected + $creditCost;
        $self'credits_sold = $self'credits_sold + $msg'credits_k;
        int $pid = $self'purchase_seq;
        $self'purchase_seq = $self'purchase_seq + 1;
        $self'pending_purchases~__tact_dict_set_int_cell(257, $pid, $PendingPurchase$_store_cell($PendingPurchase$_constructor_payer_credits_k_refund_amount(__tact_context_get_sender(), $msg'credits_k, $creditCost), begin_cell()));
        int $backing = (($msg'credits_k * 10995000) + 10000000);
        $global_message($MessageParameters$_constructor_to_value_bounce_mode_body($self'capsule_hub_address, $backing, true, 0, $FundAnonPool$_store_cell($FundAnonPool$_constructor_credits_k_epoch_purchase_id($msg'credits_k, $msg'epoch, $pid), begin_cell())));
        $CreditIssuer$_contract_store(($self'sealed, $self'genesis_controller_address, $self'deployment_manifest_hash, $self'genesis_config_hash, $self'issuer_slot_count, $self'active_slot_count, $self'issuer_slots, $self'credit_price, $self'pool_collected, $self'credits_sold, $self'capsule_hub_address, $self'hub_bound, $self'pending_purchases, $self'purchase_seq, $self'airdrop_pool_address, $self'airdrop_pool_bound));
        return ();
    }
    
    ;; Receive FundAnonPoolAck message
    if (op == 0x46414e41) {
        var $msg'credits_k = in_msg~load_uint(64);
        var $msg'epoch = in_msg~load_uint(32);
        var $msg'purchase_id = in_msg~load_uint(64);
        throw_unless(21080, ( equal_slices_bits(__tact_context_get_sender(), $self'capsule_hub_address) ));
        tuple $pending = $PendingPurchase$_load_opt(__tact_dict_get_int_cell($self'pending_purchases, 257, $msg'purchase_id));
        $self'pending_purchases~__tact_dict_set_int_cell(257, $msg'purchase_id, $PendingPurchase$_store_opt(null(), begin_cell()));
        if (( ($self'airdrop_pool_bound) ? ((~ null?($pending))) : (false) )) {
            $global_send($SendParameters$_constructor_to_value_mode_bounce_body($self'airdrop_pool_address, 80000000, 1, false, $AirdropAccrue$_store_cell($AirdropAccrue$_constructor_purchase_id_buyer_credits_k($msg'purchase_id, $PendingPurchase$_get_payer($PendingPurchase$_not_null($pending)), $PendingPurchase$_get_credits_k($PendingPurchase$_not_null($pending))), begin_cell())));
        }
        $CreditIssuer$_contract_store(($self'sealed, $self'genesis_controller_address, $self'deployment_manifest_hash, $self'genesis_config_hash, $self'issuer_slot_count, $self'active_slot_count, $self'issuer_slots, $self'credit_price, $self'pool_collected, $self'credits_sold, $self'capsule_hub_address, $self'hub_bound, $self'pending_purchases, $self'purchase_seq, $self'airdrop_pool_address, $self'airdrop_pool_bound));
        return ();
    }
    
    ;; Receive CreditBindAirdropPool message
    if (op == 0x43524439) {
        var $msg'airdrop_pool_address = in_msg~load_msg_addr();
        throw_unless(21100, (~ $self'sealed));
        throw_unless(21033, ( equal_slices_bits(__tact_context_get_sender(), $self'genesis_controller_address) ));
        throw_unless(21048, (~ $self'airdrop_pool_bound));
        $self'airdrop_pool_address = $msg'airdrop_pool_address;
        $self'airdrop_pool_bound = true;
        $CreditIssuer$_contract_store(($self'sealed, $self'genesis_controller_address, $self'deployment_manifest_hash, $self'genesis_config_hash, $self'issuer_slot_count, $self'active_slot_count, $self'issuer_slots, $self'credit_price, $self'pool_collected, $self'credits_sold, $self'capsule_hub_address, $self'hub_bound, $self'pending_purchases, $self'purchase_seq, $self'airdrop_pool_address, $self'airdrop_pool_bound));
        return ();
    }
    
    ;; Receive CreditTopUpStorageReserve message
    if (op == 0x43524437) {
        var $msg = empty_tuple();
        $CreditIssuer$_contract_store(($self'sealed, $self'genesis_controller_address, $self'deployment_manifest_hash, $self'genesis_config_hash, $self'issuer_slot_count, $self'active_slot_count, $self'issuer_slots, $self'credit_price, $self'pool_collected, $self'credits_sold, $self'capsule_hub_address, $self'hub_bound, $self'pending_purchases, $self'purchase_seq, $self'airdrop_pool_address, $self'airdrop_pool_bound));
        return ();
    }
    
    ;; Receive empty message
    if ((op == 0) & (in_msg_length <= 32)) {
        $CreditIssuer$_contract_store(($self'sealed, $self'genesis_controller_address, $self'deployment_manifest_hash, $self'genesis_config_hash, $self'issuer_slot_count, $self'active_slot_count, $self'issuer_slots, $self'credit_price, $self'pool_collected, $self'credits_sold, $self'capsule_hub_address, $self'hub_bound, $self'pending_purchases, $self'purchase_seq, $self'airdrop_pool_address, $self'airdrop_pool_bound));
        return ();
    }
    ;; Throw if not handled
    throw(130);
}
