;;
;; Routing of a Contract RecordShard
;;

;; message opcode reader utility: only binary receivers
;; Returns 32 bit message opcode, otherwise throws the "Invalid incoming message" exit code
(slice, int) ~load_opcode_internal(slice s) asm( -> 1 0) "32 LDUQ 130 THROWIFNOT";

() recv_internal(int msg_value, cell in_msg_cell, slice in_msg) impure {
    
    ;; Context
    var cs = in_msg_cell.begin_parse();
    cs~skip_bits(2);
    var msg_bounceable = cs~load_int(1);
    var msg_bounced = cs~load_int(1);
    slice msg_sender_addr = cs~load_msg_addr();
    __tact_context = (msg_bounceable, msg_sender_addr, msg_value, cs);
    __tact_context_sender = msg_sender_addr;
    
    ;; Load contract data
    var ($self'bucket_key, $self'epoch, $self'records, $self'record_count, $self'live_count, $self'evict_cursor) = $RecordShard$_contract_load();
    
    ;; Handle bounced messages
    if (msg_bounced) { return (); }
    int op = 0;
    int in_msg_length = slice_bits(in_msg);
    if (in_msg_length >= 32) {
        op = in_msg~load_uint(32);
    }
    ;; Receive CapsulePublish message
    if (op == 0x52535031) {
        var $msg'header_0 = in_msg~load_ref();
        var $msg'header_1 = in_msg~load_ref();
        var $msg'body = in_msg~load_ref();
        throw_unless(13652, ($Context$_get_value(__tact_context_get()) >= 2700000));
        throw_unless(13651, ($self'live_count < 4096));
        $self'records~__tact_dict_set_int_cell(257, $self'record_count, $RecordEntry$_store_cell($RecordEntry$_constructor_frame_commit_created_at(($self'bucket_key, $self'epoch, $self'records, $self'record_count, $self'live_count, $self'evict_cursor)~$RecordShard$_fun_frameCommit($msg'header_0, $msg'header_1, $msg'body), $global_now()), begin_cell()));
        $self'record_count = ($self'record_count + 1);
        $self'live_count = ($self'live_count + 1);
        $global_nativeReserve((2000000 + ($self'live_count * 200000)), 2);
        $global_send($SendParameters$_constructor_to_value_mode_bounce(__tact_context_get_sender(), 0, 130, false));
        $RecordShard$_contract_store(($self'bucket_key, $self'epoch, $self'records, $self'record_count, $self'live_count, $self'evict_cursor));
        return ();
    }
    
    ;; Receive EvictRecords message
    if (op == 0x52535032) {
        var $msg'max_count = in_msg~load_uint(16);
        int $swept = 0;
        int $cursor = $self'evict_cursor;
        while (( (( (($swept < $msg'max_count)) ? (($swept < 64)) : (false) )) ? (($cursor < $self'record_count)) : (false) )) {
            tuple $e = $RecordEntry$_load_opt(__tact_dict_get_int_cell($self'records, 257, $cursor));
            if ((~ null?($e))) {
                if ((($RecordEntry$_get_created_at($RecordEntry$_not_null($e)) + 31536000) < $global_now())) {
                    $self'records~__tact_dict_set_int_cell(257, $cursor, $RecordEntry$_store_opt(null(), begin_cell()));
                    $self'live_count = ($self'live_count - 1);
                    $cursor = ($cursor + 1);
                    $swept = ($swept + 1);
                } else {
                    $swept = $msg'max_count;
                }
            } else {
                $cursor = ($cursor + 1);
            }
        }
        $self'evict_cursor = $cursor;
        $RecordShard$_contract_store(($self'bucket_key, $self'epoch, $self'records, $self'record_count, $self'live_count, $self'evict_cursor));
        return ();
    }
    
    ;; Receive empty message
    if ((op == 0) & (in_msg_length <= 32)) {
        $RecordShard$_contract_store(($self'bucket_key, $self'epoch, $self'records, $self'record_count, $self'live_count, $self'evict_cursor));
        return ();
    }
    ;; Throw if not handled
    throw(130);
}
