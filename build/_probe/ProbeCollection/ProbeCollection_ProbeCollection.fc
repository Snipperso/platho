;;
;; Routing of a Contract ProbeCollection
;;

;; message opcode reader utility: only binary receivers
;; Returns 32 bit message opcode, otherwise throws the "Invalid incoming message" exit code
(slice, int) ~load_opcode_internal(slice s) asm( -> 1 0) "32 LDUQ 130 THROWIFNOT";

() recv_internal(int msg_value, cell in_msg_cell, slice in_msg) impure {
    
    ;; Context
    var cs = in_msg_cell.begin_parse();
    cs~skip_bits(2);
    var msg_bounceable = cs~load_int(1);
    var msg_bounced = cs~load_int(1);
    slice msg_sender_addr = cs~load_msg_addr();
    __tact_context = (msg_bounceable, msg_sender_addr, msg_value, cs);
    __tact_context_sender = msg_sender_addr;
    
    ;; Load contract data
    var ($self'owner, $self'next_index, $self'collection_content, $self'contents) = $ProbeCollection$_contract_load();
    
    ;; Handle bounced messages
    if (msg_bounced) { return (); }
    int op = 0;
    int in_msg_length = slice_bits(in_msg);
    if (in_msg_length >= 32) {
        op = in_msg~load_uint(32);
    }
    ;; Receive ProbeMintAll message
    if (op == 0x50524f42) {
        var $msg'item_value = in_msg~load_varuint16();
        int $i = 0;
        while (($i < $self'next_index)) {
            var ($init'code, $init'data) = $ProbeItem$_init_child($global_myAddress(), $i, $self'owner);
            $global_send($SendParameters$_constructor_to_value_mode_bounce_code_data_body($global_contractAddress(($init'code, $init'data)), $msg'item_value, 2, false, $init'code, $init'data, $global_emptyCell()));
            $i = $i + 1;
        }
        $ProbeCollection$_contract_store(($self'owner, $self'next_index, $self'collection_content, $self'contents));
        return ();
    }
    
    ;; Receive empty message
    if ((op == 0) & (in_msg_length <= 32)) {
        $ProbeCollection$_contract_store(($self'owner, $self'next_index, $self'collection_content, $self'contents));
        return ();
    }
    ;; Throw if not handled
    throw(130);
}
