(slice, int, slice) $ProbeItem$_contract_load() impure inline {
    slice $sc = get_data().begin_parse();
    int $loaded = $sc~load_int(1);
    if ($loaded) {
        return $sc~$ProbeItem$_load();
    }
    else {
        (slice $collection, int $index, slice $owner) = $sc~$ProbeItem$init$_load();
        $sc.end_parse();
        return $ProbeItem$_contract_init($collection, $index, $owner);
    }
}

() $ProbeItem$_contract_store((slice, int, slice) v) impure inline {
    builder b = begin_cell();
    b = b.store_int(true, 1);
    b = $ProbeItem$_store(b, v);
    set_data(b.end_cell());
}

