builder $ATHBurn$_store(builder build_0, (int, int, slice) v) inline {
    var (v'query_id, v'amount, v'response_destination) = v;
    build_0 = store_uint(build_0, 1096042497, 32);
    build_0 = build_0.store_uint(v'query_id, 64);
    build_0 = build_0.store_uint(v'amount, 128);
    build_0 = build_0.store_slice(v'response_destination);
    return build_0;
}

