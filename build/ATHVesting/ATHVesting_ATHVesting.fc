        $global_message($MessageParameters$_constructor_to_value_bounce_mode_body(($self'ath_master_address, $self'beneficiary_address, $self'start_time, $self'claimed_ath, $self'phase, $self'pending_query_id, $self'pending_amount, $self'pending_recipient_ath_wallet, $self'pending_created_at, $self'last_terminal_query_id)~$ATHVesting$_fun_ownAthWalletAddress(), 58000000, true, 1, $ATHTransferRequest$_store_cell($ATHTransferRequest$_constructor_query_id_amount_recipient_response_destination($msg'query_id, $msg'amount, $self'beneficiary_address, $global_myAddress()), begin_cell())));
        ($self'ath_master_address, $self'beneficiary_address, $self'start_time, $self'claimed_ath, $self'phase, $self'pending_query_id, $self'pending_amount, $self'pending_recipient_ath_wallet, $self'pending_created_at, $self'last_terminal_query_id)~$ATHVesting$_fun_refundExcess(__tact_context_get_sender(), ($Context$_get_value(__tact_context_get()) - $requiredValue));
        $ATHVesting$_contract_store(($self'ath_master_address, $self'beneficiary_address, $self'start_time, $self'claimed_ath, $self'phase, $self'pending_query_id, $self'pending_amount, $self'pending_recipient_ath_wallet, $self'pending_created_at, $self'last_terminal_query_id));
        return ();
    }
    
    ;; Receive ATHTransferAck message
    if (op == 0x41544811) {
        var $msg'query_id = in_msg~load_uint(64);
        var $msg'amount = in_msg~load_uint(128);
        throw_unless(24200, ($self'phase == 1));
        throw_unless(24201, ($msg'query_id == $self'pending_query_id));
        throw_unless(24202, ($msg'amount == $self'pending_amount));
        throw_unless(24203, ( equal_slices_bits(__tact_context_get_sender(), $self'pending_recipient_ath_wallet) ));
        int $queryId = $self'pending_query_id;
        int $amount = $self'pending_amount;
        $self'claimed_ath = $self'claimed_ath + $amount;
        throw_unless(24204, ($self'claimed_ath <= 10000000000000000));
        ($self'ath_master_address, $self'beneficiary_address, $self'start_time, $self'claimed_ath, $self'phase, $self'pending_query_id, $self'pending_amount, $self'pending_recipient_ath_wallet, $self'pending_created_at, $self'last_terminal_query_id)~$ATHVesting$_fun_clearPending();
        ($self'ath_master_address, $self'beneficiary_address, $self'start_time, $self'claimed_ath, $self'phase, $self'pending_query_id, $self'pending_amount, $self'pending_recipient_ath_wallet, $self'pending_created_at, $self'last_terminal_query_id)~$ATHVesting$_fun_recordTerminalQuery($queryId);
        $ATHVesting$_contract_store(($self'ath_master_address, $self'beneficiary_address, $self'start_time, $self'claimed_ath, $self'phase, $self'pending_query_id, $self'pending_amount, $self'pending_recipient_ath_wallet, $self'pending_created_at, $self'last_terminal_query_id));
        return ();
    }
    
    ;; Receive ATHTransferFailed message
    if (op == 0x41544813) {
        var $msg'query_id = in_msg~load_uint(64);
        var $msg'amount = in_msg~load_uint(128);
        throw_unless(24210, ( equal_slices_bits(__tact_context_get_sender(), ($self'ath_master_address, $self'beneficiary_address, $self'start_time, $self'claimed_ath, $self'phase, $self'pending_query_id, $self'pending_amount, $self'pending_recipient_ath_wallet, $self'pending_created_at, $self'last_terminal_query_id)~$ATHVesting$_fun_ownAthWalletAddress()) ));
        throw_unless(24211, ($self'phase == 1));
        throw_unless(24212, ($msg'query_id == $self'pending_query_id));
        throw_unless(24213, ($msg'amount == $self'pending_amount));
        int $queryId = $self'pending_query_id;
        ($self'ath_master_address, $self'beneficiary_address, $self'start_time, $self'claimed_ath, $self'phase, $self'pending_query_id, $self'pending_amount, $self'pending_recipient_ath_wallet, $self'pending_created_at, $self'last_terminal_query_id)~$ATHVesting$_fun_clearPending();
        ($self'ath_master_address, $self'beneficiary_address, $self'start_time, $self'claimed_ath, $self'phase, $self'pending_query_id, $self'pending_amount, $self'pending_recipient_ath_wallet, $self'pending_created_at, $self'last_terminal_query_id)~$ATHVesting$_fun_recordTerminalQuery($queryId);
        $ATHVesting$_contract_store(($self'ath_master_address, $self'beneficiary_address, $self'start_time, $self'claimed_ath, $self'phase, $self'pending_query_id, $self'pending_amount, $self'pending_recipient_ath_wallet, $self'pending_created_at, $self'last_terminal_query_id));
        return ();
    }
    
    ;; Receive ATHVestingTopUpStorageReserve message
    if (op == 0x41545654) {
        var $msg = empty_tuple();
        $ATHVesting$_contract_store(($self'ath_master_address, $self'beneficiary_address, $self'start_time, $self'claimed_ath, $self'phase, $self'pending_query_id, $self'pending_amount, $self'pending_recipient_ath_wallet, $self'pending_created_at, $self'last_terminal_query_id));
        return ();
    }
    
    ;; Receive empty message
    if ((op == 0) & (in_msg_length <= 32)) {
        throw(24999);
        $ATHVesting$_contract_store(($self'ath_master_address, $self'beneficiary_address, $self'start_time, $self'claimed_ath, $self'phase, $self'pending_query_id, $self'pending_amount, $self'pending_recipient_ath_wallet, $self'pending_created_at, $self'last_terminal_query_id));
        return ();
    }
    ;; Throw if not handled
    throw(130);
}
