() $MockAthWalletNoAck$_contract_store(tuple v) impure inline;


;; MockAthWalletNoAck_MockAthWalletNoAck.stdlib.fc
global (int, slice, int, slice) __tact_context;
global slice __tact_context_sender;
global cell __tact_child_contract_codes;
global int __tact_randomized;

;; MockAthWalletNoAck_MockAthWalletNoAck.storage.fc
;;
;; Type: MockAthWalletNoAck
;; TLB: _  = MockAthWalletNoAck
;;

tuple $MockAthWalletNoAck$_contract_load() impure inline {
    slice $sc = get_data().begin_parse();
    int $loaded = $sc~load_int(1);
    if ($loaded) {
        return null();
    }
    else {
        return $MockAthWalletNoAck$_contract_init();
    }
}

() $MockAthWalletNoAck$_contract_store(tuple v) impure inline {
    builder b = begin_cell();
    b = b.store_int(true, 1);
    set_data(b.end_cell());
}

;;
;; Contract MockAthWalletNoAck functions
;;

tuple $MockAthWalletNoAck$_contract_init() impure inline {
    tuple $self = null();
    return $self;
}

;;
