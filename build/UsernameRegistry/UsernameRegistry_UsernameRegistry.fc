        ($self'official_ath_wallet_address, $self'vault_address, $self'ath_master_address, $self'treasury_ath_receiver_address, $self'official_ath_wallet_bound, $self'vault_bound, $self'sealed, $self'deployment_manifest_hash, $self'genesis_config_hash, $self'name_record_count, $self'pending_mint_count, $self'treasury_due_ath, $self'burn_due_ath, $self'name_records, $self'pending_mints, $self'pending_item_to_name_hash, $self'pending_treasury_flushes, $self'pending_treasury_flush_count, $self'pending_burn_flushes, $self'pending_burn_flush_count, $self'genesis_controller_address)~$UsernameRegistry$_fun_requireSealed();
        throw_unless(19158, ( equal_slices_bits(__tact_context_get_sender(), $self'official_ath_wallet_address) ));
        tuple $treasuryPendingOpt = $PendingAthTreasuryFlush$_load_opt(__tact_dict_get_int_cell($self'pending_treasury_flushes, 257, $msg'query_id));
        throw_unless(19240, (~ null?($treasuryPendingOpt)));
        var ($treasuryPending'amount, $treasuryPending'recipient_ath_wallet, $treasuryPending'created_at) = ($self'official_ath_wallet_address, $self'vault_address, $self'ath_master_address, $self'treasury_ath_receiver_address, $self'official_ath_wallet_bound, $self'vault_bound, $self'sealed, $self'deployment_manifest_hash, $self'genesis_config_hash, $self'name_record_count, $self'pending_mint_count, $self'treasury_due_ath, $self'burn_due_ath, $self'name_records, $self'pending_mints, $self'pending_item_to_name_hash, $self'pending_treasury_flushes, $self'pending_treasury_flush_count, $self'pending_burn_flushes, $self'pending_burn_flush_count, $self'genesis_controller_address)~$UsernameRegistry$_fun_clearPendingTreasuryFlush($msg'query_id);
        throw_unless(19241, ($msg'amount == $treasuryPending'amount));
        $self'treasury_due_ath = $self'treasury_due_ath + $treasuryPending'amount;
        $UsernameRegistry$_contract_store(($self'official_ath_wallet_address, $self'vault_address, $self'ath_master_address, $self'treasury_ath_receiver_address, $self'official_ath_wallet_bound, $self'vault_bound, $self'sealed, $self'deployment_manifest_hash, $self'genesis_config_hash, $self'name_record_count, $self'pending_mint_count, $self'treasury_due_ath, $self'burn_due_ath, $self'name_records, $self'pending_mints, $self'pending_item_to_name_hash, $self'pending_treasury_flushes, $self'pending_treasury_flush_count, $self'pending_burn_flushes, $self'pending_burn_flush_count, $self'genesis_controller_address));
        return ();
    }
    
    ;; Receive ATHBurnFinalized message
    if (op == 0x41544803) {
        var $msg'query_id = in_msg~load_uint(64);
        var $msg'amount = in_msg~load_uint(128);
        var $msg'owner_address = in_msg~load_msg_addr();
        ($self'official_ath_wallet_address, $self'vault_address, $self'ath_master_address, $self'treasury_ath_receiver_address, $self'official_ath_wallet_bound, $self'vault_bound, $self'sealed, $self'deployment_manifest_hash, $self'genesis_config_hash, $self'name_record_count, $self'pending_mint_count, $self'treasury_due_ath, $self'burn_due_ath, $self'name_records, $self'pending_mints, $self'pending_item_to_name_hash, $self'pending_treasury_flushes, $self'pending_treasury_flush_count, $self'pending_burn_flushes, $self'pending_burn_flush_count, $self'genesis_controller_address)~$UsernameRegistry$_fun_requireSealed();
        throw_unless(19270, ( equal_slices_bits(__tact_context_get_sender(), $self'ath_master_address) ));
        throw_unless(19271, ( equal_slices_bits($msg'owner_address, $global_myAddress()) ));
        var ($pending'amount, $pending'created_at) = ($self'official_ath_wallet_address, $self'vault_address, $self'ath_master_address, $self'treasury_ath_receiver_address, $self'official_ath_wallet_bound, $self'vault_bound, $self'sealed, $self'deployment_manifest_hash, $self'genesis_config_hash, $self'name_record_count, $self'pending_mint_count, $self'treasury_due_ath, $self'burn_due_ath, $self'name_records, $self'pending_mints, $self'pending_item_to_name_hash, $self'pending_treasury_flushes, $self'pending_treasury_flush_count, $self'pending_burn_flushes, $self'pending_burn_flush_count, $self'genesis_controller_address)~$UsernameRegistry$_fun_clearPendingBurnFlush($msg'query_id);
        throw_unless(19272, ($msg'amount == $pending'amount));
        $UsernameRegistry$_contract_store(($self'official_ath_wallet_address, $self'vault_address, $self'ath_master_address, $self'treasury_ath_receiver_address, $self'official_ath_wallet_bound, $self'vault_bound, $self'sealed, $self'deployment_manifest_hash, $self'genesis_config_hash, $self'name_record_count, $self'pending_mint_count, $self'treasury_due_ath, $self'burn_due_ath, $self'name_records, $self'pending_mints, $self'pending_item_to_name_hash, $self'pending_treasury_flushes, $self'pending_treasury_flush_count, $self'pending_burn_flushes, $self'pending_burn_flush_count, $self'genesis_controller_address));
        return ();
    }
    
    ;; Receive ATHBurnFailed message
    if (op == 0x41544804) {
        var $msg'query_id = in_msg~load_uint(64);
        var $msg'amount = in_msg~load_uint(128);
        ($self'official_ath_wallet_address, $self'vault_address, $self'ath_master_address, $self'treasury_ath_receiver_address, $self'official_ath_wallet_bound, $self'vault_bound, $self'sealed, $self'deployment_manifest_hash, $self'genesis_config_hash, $self'name_record_count, $self'pending_mint_count, $self'treasury_due_ath, $self'burn_due_ath, $self'name_records, $self'pending_mints, $self'pending_item_to_name_hash, $self'pending_treasury_flushes, $self'pending_treasury_flush_count, $self'pending_burn_flushes, $self'pending_burn_flush_count, $self'genesis_controller_address)~$UsernameRegistry$_fun_requireSealed();
        throw_unless(19280, ( equal_slices_bits(__tact_context_get_sender(), $self'official_ath_wallet_address) ));
        var ($pending'amount, $pending'created_at) = ($self'official_ath_wallet_address, $self'vault_address, $self'ath_master_address, $self'treasury_ath_receiver_address, $self'official_ath_wallet_bound, $self'vault_bound, $self'sealed, $self'deployment_manifest_hash, $self'genesis_config_hash, $self'name_record_count, $self'pending_mint_count, $self'treasury_due_ath, $self'burn_due_ath, $self'name_records, $self'pending_mints, $self'pending_item_to_name_hash, $self'pending_treasury_flushes, $self'pending_treasury_flush_count, $self'pending_burn_flushes, $self'pending_burn_flush_count, $self'genesis_controller_address)~$UsernameRegistry$_fun_clearPendingBurnFlush($msg'query_id);
        throw_unless(19281, ($msg'amount == $pending'amount));
        $self'burn_due_ath = $self'burn_due_ath + $pending'amount;
        $UsernameRegistry$_contract_store(($self'official_ath_wallet_address, $self'vault_address, $self'ath_master_address, $self'treasury_ath_receiver_address, $self'official_ath_wallet_bound, $self'vault_bound, $self'sealed, $self'deployment_manifest_hash, $self'genesis_config_hash, $self'name_record_count, $self'pending_mint_count, $self'treasury_due_ath, $self'burn_due_ath, $self'name_records, $self'pending_mints, $self'pending_item_to_name_hash, $self'pending_treasury_flushes, $self'pending_treasury_flush_count, $self'pending_burn_flushes, $self'pending_burn_flush_count, $self'genesis_controller_address));
        return ();
    }
    
    ;; Receive PrunePendingUsernameMint message
    if (op == 0x3796df2d) {
        var $msg'name_hash = in_msg~load_uint(256);
        ($self'official_ath_wallet_address, $self'vault_address, $self'ath_master_address, $self'treasury_ath_receiver_address, $self'official_ath_wallet_bound, $self'vault_bound, $self'sealed, $self'deployment_manifest_hash, $self'genesis_config_hash, $self'name_record_count, $self'pending_mint_count, $self'treasury_due_ath, $self'burn_due_ath, $self'name_records, $self'pending_mints, $self'pending_item_to_name_hash, $self'pending_treasury_flushes, $self'pending_treasury_flush_count, $self'pending_burn_flushes, $self'pending_burn_flush_count, $self'genesis_controller_address)~$UsernameRegistry$_fun_requireSealed();
        throw_unless(19305, ($Context$_get_value(__tact_context_get()) >= 2000000));
        throw_unless(19301, ($msg'name_hash != 0));
        tuple $pendingOpt = $PendingUsernameMint$_load_opt(__tact_dict_get_int_cell($self'pending_mints, 257, $msg'name_hash));
        throw_unless(19302, (~ null?($pendingOpt)));
        var ($pending'query_id, $pending'sender_key, $pending'owner_wallet, $pending'name_hash, $pending'price_paid, $pending'item_address, $pending'item_deploy_value, $pending'created_at) = $PendingUsernameMint$_not_null($pendingOpt);
        throw_unless(19303, ($global_now() >= ($pending'created_at + 86400)));
        throw_unless(19304, (~ __tact_dict_exists_int($self'name_records, 257, $msg'name_hash)));
        throw(19307);
        $UsernameRegistry$_contract_store(($self'official_ath_wallet_address, $self'vault_address, $self'ath_master_address, $self'treasury_ath_receiver_address, $self'official_ath_wallet_bound, $self'vault_bound, $self'sealed, $self'deployment_manifest_hash, $self'genesis_config_hash, $self'name_record_count, $self'pending_mint_count, $self'treasury_due_ath, $self'burn_due_ath, $self'name_records, $self'pending_mints, $self'pending_item_to_name_hash, $self'pending_treasury_flushes, $self'pending_treasury_flush_count, $self'pending_burn_flushes, $self'pending_burn_flush_count, $self'genesis_controller_address));
        return ();
    }
    
    ;; Receive UsernameRegistryTopUpStorageReserve message
    if (op == 0xaba5f1d) {
