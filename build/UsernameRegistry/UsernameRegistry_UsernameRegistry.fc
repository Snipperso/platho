;; Type: InitializeUsernameItem
;; Header: 0x554e494e
;; TLB: initialize_username_item#554e494e owner_wallet:address username_len:uint8 username:remainder<slice> = InitializeUsernameItem
;;

builder $InitializeUsernameItem$_store(builder build_0, (slice, int, slice) v) inline {
    var (v'owner_wallet, v'username_len, v'username) = v;
    build_0 = store_uint(build_0, 1431193934, 32);
    build_0 = build_0.store_slice(v'owner_wallet);
    build_0 = build_0.store_uint(v'username_len, 8);
    build_0 = build_0.store_slice(v'username);
    return build_0;
}

cell $InitializeUsernameItem$_store_cell((slice, int, slice) v, builder b) inline {
    return $InitializeUsernameItem$_store(b, v).end_cell();
}

(slice, (tuple)) $InitializeUsernameItem$_load_bounced(slice sc_0) inline {
