""";

int $Slice$_fun_empty(slice $self) impure asm """
    SEMPTY
""";

int $Slice$_fun_refsEmpty(slice $self) impure asm """
    SREMPTY
""";

slice $Slice$_fun_asString(slice $self) impure asm "NOP";

int $Cell$_fun_hash(cell $self) impure asm """
    HASHCU
""";

slice $Address$_fun_asSlice(slice $self) impure asm "NOP";

