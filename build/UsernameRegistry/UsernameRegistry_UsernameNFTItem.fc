        var $msg = empty_tuple();
        $UsernameNFTItem$_contract_store(($self'owner_wallet, $self'username_registry_address, $self'name_hash));
        return ();
    }
    
    ;; Receive empty message
    if ((op == 0) & (in_msg_length <= 32)) {
        throw(18099);
        $UsernameNFTItem$_contract_store(($self'owner_wallet, $self'username_registry_address, $self'name_hash));
