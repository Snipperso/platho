{
  "name": "Platho",
  "short_name": "Platho",
  "description": "Platho messenger shell",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "theme_color": "#0b0d0f",
  "background_color": "#0b0d0f",
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://platho.app/manifest.webmanifest"
    }
  ],
  "icons": [
    {
      "src": "./assets/platho-icon-192.png?v=3",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./assets/platho-icon-512.png?v=3",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
