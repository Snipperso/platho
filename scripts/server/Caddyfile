{
	servers {
		protocols h1 h2
	}
}

(security_headers) {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Alt-Svc "clear"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' https://toncenter.com https://*.toncenter.com https://ton.access.orbs.network https://*.orbs.network; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors https://web.telegram.org; form-action 'none'; upgrade-insecure-requests"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        Permissions-Policy "accelerometer=(), bluetooth=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), serial=(), usb=()"
    }
}

www.platho.app {
    import security_headers
    redir https://platho.app{uri} permanent
}

platho.app {
	import security_headers
	root * /srv/platho/current
	route {
		@index_html path /index.html
		redir @index_html / permanent
		@unsupported_methods method OPTIONS POST PUT PATCH DELETE TRACE CONNECT
		respond @unsupported_methods 405
		@sensitive_paths path /.git* /.env* /package*.json /tact.config.json /scripts/* /artifacts/* /server-status /backup* /config.json
		respond @sensitive_paths 404
		encode gzip
		try_files {path} /index.html
		file_server
	}
}

rpc.platho.app {
    import security_headers
    encode gzip

    # Cap the request body at the edge (matches the gateway MAX_BODY_BYTES).
    request_body {
        max_size 256KiB
    }

    route {
        # Only the routes the gateway serves; reject everything else before Python.
        @badmethods not method GET POST OPTIONS
        respond @badmethods 405

        # Overwrite X-Forwarded-For with the real client IP so a client-supplied (spoofed)
        # value can never reach the gateway's rate limiter.
        reverse_proxy 127.0.0.1:8790 {
            header_up X-Forwarded-For {remote_host}
        }
    }
}
