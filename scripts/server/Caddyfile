{
	servers {
		protocols h1 h2
	}
}

(security_headers) {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Alt-Svc "clear"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' https://toncenter.com https://*.toncenter.com https://rpc.platho.app; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors https://web.telegram.org; form-action 'none'; upgrade-insecure-requests"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        Permissions-Policy "accelerometer=(), bluetooth=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), serial=(), usb=()"
    }
}

www.platho.app {
    import security_headers
    redir https://platho.app{uri} permanent
}

platho.app {
	import security_headers
	root * /srv/platho/current
	route {
		@index_html path /index.html
		redir @index_html / permanent
		@unsupported_methods method OPTIONS POST PUT PATCH DELETE TRACE CONNECT
		respond @unsupported_methods 405
		@sensitive_paths path /.git* /.env* /package*.json /tact.config.json /scripts/* /artifacts/* /server-status /backup* /config.json
		respond @sensitive_paths 404
		encode gzip
		try_files {path} /index.html
		file_server
	}
}

rpc.platho.app {
    import security_headers
    encode gzip
    reverse_proxy 127.0.0.1:8790
}
