# Platho M20T disposable testnet deployment env template.
# Copy to .env.testnet.local and keep it local. Never commit real mnemonic/private key material.

PLATHO_NETWORK=testnet
PLATHO_TON_RPC_ENDPOINT=https://testnet.toncenter.com/api/v2/jsonRPC
PLATHO_TON_RPC_API_KEY=

# Disposable deployer only. Do not use production/mainnet wallets here.
PLATHO_TESTNET_DEPLOYER_MNEMONIC="FILL_WITH_DISPOSABLE_TESTNET_WALLET_MNEMONIC_ONLY_IN_LOCAL_FILE"
PLATHO_TESTNET_DEPLOYER_WALLET_VERSION=v4r2
PLATHO_TESTNET_DEPLOYER_ADDRESS="FILL_AFTER_GENERATION"

# Funding gate. 51.05 TON envelope + deploy/probe fees require a funded testnet wallet.
PLATHO_TESTNET_MIN_BALANCE_NANOTONS=55000000000

# Optional test ATH/test router values. Leave empty until M20T scripts produce or capture them.
PLATHO_TESTNET_ATH_MASTER_ADDRESS=
PLATHO_TESTNET_FEEACCUMULATOR_ADDRESS=
PLATHO_TESTNET_BUYBACKBURN_OR_HARNESS_ADDRESS=
PLATHO_TESTNET_BUYBACKBURN_OFFICIAL_ATH_WALLET_ADDRESS=
PLATHO_TESTNET_STONFI_ROUTER_ADDRESS=
PLATHO_TESTNET_STONFI_PTON_WALLET_ADDRESS=
PLATHO_TESTNET_STONFI_POOL_TON_ATH_ADDRESS=

# Safety latch: M20T is behavioral testnet evidence only, not mainnet route freeze.
PLATHO_M20T_ALLOW_MAINNET=false
PLATHO_M20T_SET_STONFI_ROUTE_FREEZE_READY=false
PLATHO_M20T_SET_BUYBACKBURN_IMPLEMENTATION_READY=false
