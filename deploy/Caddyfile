(platho_security_headers) {
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Cross-Origin-Opener-Policy "same-origin"
    Cross-Origin-Resource-Policy "same-origin"
    -Server
  }
}

platho.app {
  import platho_security_headers

  encode zstd gzip
  root * /var/www/platho.app/current

  @service_worker path /sw.js
  header @service_worker Cache-Control "no-cache, no-store, must-revalidate"

  @html path / /index.html
  header @html Cache-Control "no-cache"

  @manifest path /manifest.webmanifest /tonconnect-manifest.json
  header @manifest Cache-Control "no-cache"

  @runtime path /app.js /styles.css /replay-store.mjs /vault-chain-provider.mjs /crypto/*
  header @runtime Cache-Control "public, max-age=3600"

  @static path /assets/* /vendor/*
  header @static Cache-Control "public, max-age=86400"

  try_files {path} /index.html
  file_server
}

www.platho.app {
  redir https://platho.app{uri} permanent
}
