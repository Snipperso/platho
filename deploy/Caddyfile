{
  servers {
    protocols h1 h2
  }
}

(platho_security_headers) {
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' https://toncenter.com https://*.toncenter.com https://ton.access.orbs.network https://*.orbs.network; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors https://web.telegram.org; form-action 'none'; upgrade-insecure-requests"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Cross-Origin-Opener-Policy "same-origin"
    Cross-Origin-Resource-Policy "same-origin"
    -Server
  }
}

(platho_rpc_headers) {
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Alt-Svc "clear"
    # rpc serves JSON only — lock it all the way down.
    Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
    X-Frame-Options "DENY"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "no-referrer"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Cross-Origin-Opener-Policy "same-origin"
    Cross-Origin-Resource-Policy "same-origin"
    -Server
  }
}

platho.app {
  import platho_security_headers

  encode zstd gzip
  root * /srv/platho/current

  @service_worker path /sw.js
  header @service_worker Cache-Control "no-cache, no-store, must-revalidate"

  @html path / /index.html
  header @html Cache-Control "no-cache"

  @manifest path /manifest.webmanifest
  header @manifest Cache-Control "no-cache"

  @runtime path /app.js /styles.css /platho-config.mjs /capsule-part-policy.mjs /message-pricing-policy.mjs /public-channel-subscriptions.mjs /recipient-identities.mjs /encrypted-message-store.mjs /platho-wallet.mjs /ton-mnemonic-wordlist.mjs /pwa-contract-transactions.mjs /vault-ton-rpc-provider.mjs /ton-dns-provider.mjs /capsulehub-ton-rpc-provider.mjs /ath-ton-rpc-provider.mjs /profile-registry-ton-rpc-provider.mjs /username-ton-rpc-provider.mjs /replay-store.mjs /vault-chain-provider.mjs /webp-encoder.mjs /qr-code.mjs /crypto/*
  header @runtime Cache-Control "public, max-age=3600"

  @static path /assets/* /vendor/*
  header @static Cache-Control "public, max-age=86400"

  @strict_static path /sw.js /index.html /manifest.webmanifest *.css *.js *.mjs *.json *.md *.wasm *.svg *.png

  handle @strict_static {
    file_server
  }

  handle @static {
    file_server
  }

  handle {
    try_files {path} /index.html
    file_server
  }
}

www.platho.app {
  redir https://platho.app{uri} permanent
}

rpc.platho.app {
  import platho_rpc_headers

  encode zstd gzip

  # Cap the request body at the edge (matches the gateway MAX_BODY_BYTES).
  request_body {
    max_size 256KiB
  }

  route {
    # Only the routes the gateway serves; reject everything else before it reaches Python.
    @badmethods not method GET POST OPTIONS
    respond @badmethods 405

    # Overwrite X-Forwarded-For with the real client IP so a client-supplied (spoofed) value
    # can never reach the gateway's rate limiter. Clients connect directly to Caddy, so the
    # immediate peer IS the real client.
    reverse_proxy 127.0.0.1:8790 {
      header_up X-Forwarded-For {remote_host}
    }
  }

  # OPTIONAL but recommended: an edge rate limit independent of the gateway's in-process one.
  # Requires the caddy-ratelimit module (github.com/mholt/caddy-ratelimit). Example:
  #   rate_limit {
  #     zone rpc { key {remote_host}; events 600; window 1m }
  #   }
}
