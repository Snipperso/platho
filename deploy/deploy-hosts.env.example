# Copy to artifacts/local/deploy-hosts.env and fill in. That path is gitignored; THIS file is not.
#
# WHY THIS EXISTS. Until 2026-09-05 the production address, the standby address and both SSH key filenames were
# hardcoded as defaults in six tracked scripts and in deploy/README.md — in a PUBLIC repository. None of it is a
# credential (SSH here is key-only, with AllowUsers, fail2ban and a default-deny firewall), so nothing was
# exposed that grants access. What it did hand over for free was the target list, and one entry of that list is
# worse than the rest: the standby machine's whole value is that it is NOT in DNS and takes no organic traffic,
# and the repository published it as the default deploy host. The production address is public by definition —
# DNS resolves platho.app to it — but the standby's was not, until we printed it.
#
# Scripts read this file, then the environment (a variable already set in the shell wins, which is what makes a
# one-off `PLATHO_HOST_PRODUCTION=... npm run web:deploy` possible), and refuse to guess: a missing value is a
# named error pointing back here, never a silent fallback to some other machine.
#
# Format: KEY=value, no quotes, no shell expansion, '#' starts a comment. Key filenames are BASENAMES inside
# ~/.ssh, not full paths, so the file stays portable between the machines that run these scripts.

# The machine `npm run web:deploy` targets (the PWA's production site).
PLATHO_HOST_PRODUCTION=203.0.113.10

# The machine `npm run web:deploy:stage` targets (stage.platho.app).
PLATHO_HOST_STAGE=203.0.113.11

# The forced-command deploy account: it may only unpack a release, list, roll back and prune.
PLATHO_DEPLOY_USER=platho-deploy
PLATHO_DEPLOY_KEY=your_deploy_key_ed25519

# The admin account, used by the health/backup scripts and the about-site deploy.
PLATHO_ADMIN_USER=admin
PLATHO_ADMIN_KEY=your_admin_key_ed25519

# Pinned host fingerprints. Also outside git — it names the same machines.
PLATHO_KNOWN_HOSTS=artifacts/local/known_hosts
