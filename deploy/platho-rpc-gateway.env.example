PLATHO_RPC_HOST=127.0.0.1
PLATHO_RPC_PORT=8790
PLATHO_RPC_ALLOWED_ORIGINS=https://platho.app,https://www.platho.app
PLATHO_RPC_RATE_LIMIT_PER_MINUTE=240
PLATHO_RPC_UPSTREAM_TIMEOUT_MS=15000
PLATHO_RPC_UPSTREAM_KIND=ton-access-v2

# Default mode uses Orbs TON Access: anonymous, no API key, and no paid provider account.
# It provides TonCenter v2 read access through independent Orbs nodes. The gateway adapts it to
# the PWA's /api/v3/runGetMethod shape for critical-read verification.
PLATHO_RPC_TON_ACCESS_HOST=ton.access.orbs.network
PLATHO_RPC_TON_ACCESS_NETWORK=mainnet
