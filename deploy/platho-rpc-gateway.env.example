PLATHO_RPC_HOST=127.0.0.1
PLATHO_RPC_PORT=8790
# Production allowlist. The gateway default is prod-only; set PLATHO_RPC_DEV=1 to also accept
# localhost dev origins. An unset PLATHO_RPC_ALLOWED_ORIGINS fails closed to platho.app.
PLATHO_RPC_ALLOWED_ORIGINS=https://platho.app,https://www.platho.app
PLATHO_RPC_RATE_LIMIT_PER_MINUTE=240
PLATHO_RPC_UPSTREAM_TIMEOUT_MS=15000
PLATHO_RPC_UPSTREAM_USER_AGENT=PlathoRpcGateway/1.0 (+https://platho.app)
PLATHO_RPC_UPSTREAM_KIND=toncenter-v3

# Preferred production mode uses a server-side TonCenter API key. Store the key in this root-only
# file; never put the key in web/ assets, git, or process arguments. If the key is missing or
# revoked, the gateway retries TonCenter anonymously so the PWA never falls back to direct sendBoc.
PLATHO_RPC_TONCENTER_API_KEY_FILE=/etc/platho/toncenter-mainnet.key
PLATHO_RPC_TONCENTER_AUTH_RETRY_MS=60000
# A single transient upstream 401/403 must not flip the whole gateway keyless. Only after this
# many CONSECUTIVE 401s is the key disabled process-wide; a 403 only degrades that one request,
# and any keyed 2xx resets the counter. The disable is logged loudly (security_event).
PLATHO_RPC_TONCENTER_AUTH_FAIL_THRESHOLD=3
PLATHO_RPC_TONCENTER_V3_BASE=https://toncenter.com/api/v3
PLATHO_RPC_TONCENTER_V2_BASE=https://toncenter.com/api/v2
PLATHO_RPC_ALLOWED_MESSAGE_DESTINATIONS=0:7e11a0915d22ff1f2457869ed8312b90c4a71260f12f46dabe844c2c7f37a97c,0:18c179c6147cf4c992c3291346a1fa264bdc96af3c4c9f23cef80f838b965007
PLATHO_RPC_ALLOWED_MESSAGE_SOURCES=0:18c179c6147cf4c992c3291346a1fa264bdc96af3c4c9f23cef80f838b965007,0:7e11a0915d22ff1f2457869ed8312b90c4a71260f12f46dabe844c2c7f37a97c
PLATHO_RPC_ALLOWED_MESSAGE_OPCODES=0xa4f862c0,0xa4f862d1,0x8c2a76b7,0x874e576a
PLATHO_RPC_MESSAGES_MAX_OFFSET=8000

# Fallback mode uses Orbs TON Access: anonymous, no API key, no /api/v3/messages history route.
PLATHO_RPC_TON_ACCESS_HOST=ton.access.orbs.network
PLATHO_RPC_TON_ACCESS_NETWORK=mainnet

# In toncenter-v3 mode, get-method and account reads retry once through anonymous TON Access
# when TonCenter times out or fails server-side (5xx/429). Message history has no v2 equivalent
# and never falls back. Set 0 to disable the read fallback.
PLATHO_RPC_TON_ACCESS_READ_FALLBACK=1

# Broadcast resilience: toncenter v3 /message can ACK (HTTP 200 + message_hash) WITHOUT the
# external reaching the network (upstream queue/timeout). When on, every broadcast is ALSO
# submitted through the keyless Orbs v2 /sendBoc path so delivery never hinges on toncenter
# alone. The external is idempotent (fixed seqno) — a duplicate broadcast is harmless. Set 0
# to disable and broadcast through toncenter v3 only.
PLATHO_RPC_BROADCAST_REDUNDANT_FALLBACK=1

# --- Abuse / DoS hardening -------------------------------------------------------------------
# The gateway is an unauthenticated public endpoint; these are the real defenses, not CORS.
#
# Real client IP for rate limiting comes from the Nth-from-last X-Forwarded-For hop (Caddy = 1),
# never the spoofable client-supplied leftmost token. Set 0 to ignore XFF and use the TCP peer.
PLATHO_RPC_FORWARDED_FOR_TRUSTED_HOPS=1
# Dedicated, much tighter limit for the state-changing broadcast route (per client IP / minute).
PLATHO_RPC_BROADCAST_RATE_LIMIT_PER_MINUTE=30
# Global circuit breaker on upstream calls per minute, summed across all clients (0 = off).
# Bounds total paid-key spend even under distributed (botnet) abuse that spreads across IPs.
# Anchor it just under the toncenter key's own rate tier so the gateway sheds load (503) BEFORE
# toncenter throttles/flags the key. Our key is 10 rps -> 600/min. Real Platho traffic is far
# below this, so legitimate users are never affected.
PLATHO_RPC_GLOBAL_UPSTREAM_PER_MINUTE=600
# Bounded concurrent in-flight requests (excess gets a fast 503) + hard cap on rate-limit buckets.
PLATHO_RPC_MAX_CONCURRENT_REQUESTS=64
PLATHO_RPC_MAX_RATE_LIMIT_BUCKETS=50000
# Inbound socket timeout (slowloris / dribbled-body cap).
PLATHO_RPC_HANDLER_TIMEOUT_MS=15000
# Reject the broadcast when no Origin header is present (cheap brake on no-Origin curl abuse).
PLATHO_RPC_REQUIRE_ORIGIN_FOR_BROADCAST=1
# Structurally validate every relayed external (well-formed single ext-in message). Our builders
# always produce valid externals, so this only rejects garbage / relay-abuse blobs.
PLATHO_RPC_VALIDATE_BROADCAST_STRUCTURE=1
# Cap the /message boc size to a realistic external (a valid single external is <= 65535 bytes
# ~= 87380 base64 chars), so a 256KB padding blob can never be relayed / double-broadcast.
PLATHO_RPC_MESSAGE_MAX_BOC_CHARS=90000
# Optional destination allowlist for the BROADCAST route (empty = structural validation only).
# Leave empty unless EVERY broadcast target is known: wallet activation/transfer externals are
# addressed to the user's own wallet, so a hard allowlist here would break onboarding.
PLATHO_RPC_ALLOWED_BROADCAST_DESTINATIONS=
# Never echo raw upstream error bodies to clients (upstream recon / future key-reflection risk).
# Server logs still keep the full detail. Set 1 only for debugging.
PLATHO_RPC_EXPOSE_UPSTREAM_ERRORS=0
