PLATHO_RPC_HOST=127.0.0.1
PLATHO_RPC_PORT=8790
PLATHO_RPC_ALLOWED_ORIGINS=https://platho.app,https://www.platho.app
PLATHO_RPC_RATE_LIMIT_PER_MINUTE=240
PLATHO_RPC_UPSTREAM_TIMEOUT_MS=15000
PLATHO_RPC_UPSTREAM_USER_AGENT=PlathoRpcGateway/1.0 (+https://platho.app)
PLATHO_RPC_UPSTREAM_KIND=toncenter-v3

# Preferred production mode uses a server-side TonCenter API key. Store the key in this root-only
# file; never put the key in web/ assets, git, or process arguments. If the key is missing or
# revoked, the gateway retries TonCenter anonymously so the PWA never falls back to direct sendBoc.
PLATHO_RPC_TONCENTER_API_KEY_FILE=/etc/platho/toncenter-mainnet.key
PLATHO_RPC_TONCENTER_AUTH_RETRY_MS=60000
PLATHO_RPC_TONCENTER_V3_BASE=https://toncenter.com/api/v3
PLATHO_RPC_TONCENTER_V2_BASE=https://toncenter.com/api/v2
PLATHO_RPC_ALLOWED_MESSAGE_DESTINATIONS=0:505f1b5a8ae9a15429eae9c43789859bf0b454f988e3d949521e8729243200a7,0:15c7034f1d6f75c11e728002541bed0693366b341d59f8d27eebe5e580dfb4a5
PLATHO_RPC_ALLOWED_MESSAGE_SOURCES=0:15c7034f1d6f75c11e728002541bed0693366b341d59f8d27eebe5e580dfb4a5,0:505f1b5a8ae9a15429eae9c43789859bf0b454f988e3d949521e8729243200a7
PLATHO_RPC_ALLOWED_MESSAGE_OPCODES=0xa4f862c0,0xa4f862d1,0x8c2a76b7,0x874e576a
PLATHO_RPC_MESSAGES_MAX_OFFSET=8000

# Fallback mode uses Orbs TON Access: anonymous, no API key, no /api/v3/messages history route.
PLATHO_RPC_TON_ACCESS_HOST=ton.access.orbs.network
PLATHO_RPC_TON_ACCESS_NETWORK=mainnet

# In toncenter-v3 mode, get-method and account reads retry once through anonymous TON Access
# when TonCenter times out or fails server-side (5xx/429). Broadcast and message history never
# fall back because TON Access has no v3 equivalent. Set 0 to disable the read fallback.
PLATHO_RPC_TON_ACCESS_READ_FALLBACK=1
