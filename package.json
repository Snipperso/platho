{
  "name": "platho",
  "version": "1.3.2",
  "private": true,
  "main": "index.js",
  "scripts": {
    "build": "node scripts/tact_build.js --config tact.config.json",
    "vectors": "ts-node scripts/generate_ath_wallet_vectors.ts",
    "test": "vitest run --config vitest.all.config.ts",
    "test:web": "node scripts/run_targeted_web_suite.mjs",
    "test:regression:file": "vitest run --testTimeout=30000",
    "test:all": "vitest run --config vitest.all.config.ts --reporter=verbose",
    "test:debug": "PLATHO_VITEST_DEBUG_LOG=vitest-full-debug.log vitest run --config vitest.debug.config.ts --reporter=verbose",
    "test:file": "vitest run --testTimeout=30000",
    "test:binding": "vitest run tests/deployment-binding.test.ts --testTimeout=30000",
    "crypto:selftest": "node scripts/platho_web_crypto_selftest.mjs",
    "wallet:vanity": "node scripts/vanity_ton_wallet.mjs",
    "mainnet:ath-master:derive": "ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\"}\" scripts/mainnet_ath_master_derivation.ts",
    "mainnet:ath-metadata": "ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\"}\" scripts/generate_ath_metadata_content.ts",
    "m20t:preflight": "node scripts/m20t_execution_preflight.mjs",
    "m20u:readiness": "ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\"}\" scripts/buybackburn_contract_readiness_m20u.ts",
    "market-stability:readiness": "ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\"}\" scripts/market_stability_seller_readiness.ts",
    "buyback:enable-preflight": "ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\"}\" scripts/enable_buyback_split_preflight.ts",
    "buyback:flush-preflight": "ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\"}\" scripts/buyback_flush_preflight.ts",
    "m20f:address-preflight": "ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\"}\" scripts/m20f_mainnet_address_unlock_preflight.ts",
    "m20f:derive-addresses": "ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\"}\" scripts/m20f_mainnet_address_derivation.ts",
    "m20f:preflight": "ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\"}\" scripts/m20f_mainnet_route_freeze_preflight.ts",
    "m20f:collect": "ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\"}\" scripts/m20f_stonfi_live_collector.ts",
    "mainnet:genesis:verify": "ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\"}\" scripts/mainnet_genesis_verify.ts artifacts/mainnet_genesis_verify_input.json",
    "mainnet:manifest:draft": "ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\"}\" scripts/mainnet_final_manifest_draft.ts",
    "mainnet:deploy:packet": "ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\"}\" scripts/mainnet_deploy_packet.ts",
    "mainnet:tx:dry-run": "ts-node --compiler-options \"{\\\"module\\\":\\\"CommonJS\\\"}\" scripts/mainnet_tx_dry_run_packet.ts",
    "mainnet:tonkeeper:console": "node scripts/mainnet_tonkeeper_console.mjs",
    "web:deploy:prepare": "node scripts/prepare_static_web_deploy.mjs --mode both",
    "audit:archive": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create_larisa_audit_archive.ps1",
    "evidence:suite": "node scripts/run_evidence_suite.mjs",
    "pricing:report": "node scripts/publish_reserve_pricing_report.mjs",
    "preprod:check": "node scripts/preprod_guard.mjs",
    "test:debug:files": "bash scripts/debug-test-files.sh",
    "web:deploy": "node scripts/deploy_static_web.mjs",
    "web:deploy:preview": "node scripts/deploy_static_web.mjs --mode preview",
    "web:deploy:stage": "node scripts/deploy_static_web.mjs --site stage",
    "admin": "node scripts/serve_admin.mjs",
    "admin:test": "vitest run --config vitest.admin.config.ts"
  },
  "keywords": [],
  "author": "Platho",
  "repository": {
    "type": "git",
    "url": "https://github.com/Snipperso/platho.git"
  },
  "homepage": "https://platho.app",
  "license": "SEE LICENSE IN LICENSE",
  "description": "No-backend encrypted messenger PWA and TON smart-contract suite",
  "dependencies": {
    "@noble/post-quantum": "^0.6.1"
  },
  "devDependencies": {
    "@ston-fi/api": "0.32.0",
    "@ston-fi/sdk": "2.7.0",
    "@tact-lang/compiler": "^1.6.13",
    "@ton/core": "^0.63.1",
    "@ton/sandbox": "^0.42.0",
    "@ton/test-utils": "^0.12.0",
    "@ton/ton": "^16.2.4",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
